{
  "name": "@hydromart/web",
  "version": "0.1.0",
  "private": true,
  "description": "Hydromart customer web app — browse, order, and track drinking-water deliveries.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:mobile": "node scripts/build-mobile.mjs",
    "start": "next start -p 3000",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:export": "playwright test -c playwright.static.config.ts",
    "test:export:customer": "node scripts/run-export-tests.mjs customer",
    "test:export:ops": "node scripts/run-export-tests.mjs ops"
  },
  "dependencies": {
    "@hydromart/access": "*",
    "@phosphor-icons/react": "^2.1.7",
    "@sentry/nextjs": "^10.70.0",
    "exceljs": "^4.4.0",
    "next": "15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.8"
  }
}
