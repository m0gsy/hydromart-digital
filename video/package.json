{
  "name": "hydromart-ops-tutorial-video",
  "private": true,
  "type": "module",
  "description": "Video tutorial Hydromart Ops (Staff Depot & Kepala Depot), dibuat dengan Remotion.",
  "scripts": {
    "studio": "remotion studio",
    "render:staff": "remotion render StaffDepot out/tutorial-staff-depot.mp4",
    "render:kepala": "remotion render KepalaDepot out/tutorial-kepala-depot.mp4",
    "render": "npm run render:staff && npm run render:kepala && npm run render:pelanggan",
    "typecheck": "tsc --noEmit",
    "naskah": "node naskah.ts",
    "stills": "node stills.mjs",
    "vo": "node vo.ts",
    "render:pelanggan": "remotion render Pelanggan out/tutorial-pelanggan.mp4"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@remotion/cli": "^4.0.545",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.545"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "typescript": "^5.6.3"
  }
}
