# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.next/
out/
# The Android binaries' exported static site (MOBILE_BUILD=1).
mobile-out/
mobile-out-*/
# Where build-mobile.mjs parks the route folders a binary does not serve. Should only
# ever exist DURING a build; a leftover means a run died and the next one restores it.
.route-stash/
*.tsbuildinfo

# Prisma
**/prisma/*.db
**/prisma/*.db-journal
**/prisma/generated/

# Environment / secrets
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Temp
tmp/
temp/

# Stray unrelated file (flagged for user review — not part of this project)
.claude/Create a single integrated CSV name.txt

# Local-disk storage adapter upload scratch (dev only)
var/
**/var/uploads/

# Alertmanager webhook secret (operator-created — see ops/alertmanager.yml)
ops/alertmanager.webhook-url

# Claude Code personal settings
.claude/settings.local.json

# Deploy state on the VPS: last-good SHA + watchdog incident dumps (host-local, and
# the dumps can contain container logs).
.deploy/

# Local UAT harness (throwaway run artefacts, not part of the product)
# The UAT harness CODE ships; its OUTPUT does not.
#
# `.uat/` was ignored whole, so `uat.yml` — scheduled monthly — ran `node .uat/run.mjs`
# against a directory that does not exist in a fresh checkout. It failed on its very first
# run with MODULE_NOT_FOUND, and left alone it would have failed at 03:00 on the first of
# every month forever, testing nothing. A harness that lives on one laptop is not a gate.
#
# What ships: run.mjs, lib.mjs, seed-queues.mjs, the m01-m29 modules, the compose file.
# What does not: run logs, results/ctx dumps, the python patch scripts, the old harness.
.uat/*.log
.uat/*.json
.uat/*.py
.uat/logs/
.uat/_prev-harness-*/
uat.json
# Signed bundles and listing assets pulled down from a Mobile release run, for uploading
# by hand. Never committed: they are build output, and the .aab is signed.
release-*/

# Local sweep artefacts (scripts/role-browser-pass.mjs)
role-pass-*.json
fase0-*.txt
probe.mjs
cart-seed.mjs
verify-*.txt
cov-*.txt
next-start.log
export-*.txt
tap-*.txt
export-sweep-*.txt
apk-build*.log
