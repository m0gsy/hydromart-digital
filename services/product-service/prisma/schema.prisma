// Hydromart product-service data model (PRD Module 3, Product Catalog).
// Global catalog. Per-depot pricing & stock are added in M5 (inventory).

generator client {
  provider = "prisma-client-js"
  // Service-local output so it never clobbers other services' @prisma/client.
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("PRODUCT_DATABASE_URL")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@index([active])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String?  @db.Uuid
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  sku         String   @unique
  description String?
  /// Sales unit label, e.g. "Galon 19L", "Botol 600ml".
  unit        String
  /// Fill volume in millilitres, e.g. 19000 for a 19L galon. Null for products
  /// that hold nothing (caps, seals, dispensers) — those are excluded from the
  /// depot water-meter reconciliation rather than counted as zero litres.
  volumeMl    Int?
  /// True for refillable galon lines. Deliberately separate from `volumeMl`:
  /// a 600ml bottle also has a volume, and conflating the two would make
  /// bottled lines attract the per-galon delivery fee (see order-service
  /// pricing.galonQuantity). One field, one job.
  isGallon    Boolean  @default(false)
  /// Catalog base price in IDR. Depot-specific overrides come later (M5).
  basePrice   Decimal  @db.Decimal(12, 2)
  imageUrl    String?
  /// Additional gallery images beyond the primary `imageUrl` (ordered). The
  /// customer gallery renders [imageUrl, ...images].
  images      String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

/// PRD-1 — every change to a network-wide base price, and who made it.
///
/// Owner decision 2026-09-11: a depot MANAGER keeps the right to edit the catalog. What the
/// audit asked for instead is the trail, and there was none: `basePrice` is the number every
/// depot sells from, it can be edited by any `catalogWrite` holder, and the row simply
/// changed. Afterwards nobody could say what it had been, who moved it, or when — for the
/// one field in this service that is money.
///
/// Append-only. Nothing here is ever updated or deleted by the service.
model ProductPriceChange {
  id        String   @id @default(uuid())
  productId String
  /// The staff account that made the change (JWT sub). Never null: a price does not move
  /// by itself, and a write with no actor has no business reaching this table.
  changedBy String
  fromPrice Decimal  @db.Decimal(12, 2)
  toPrice   Decimal  @db.Decimal(12, 2)
  changedAt DateTime @default(now())

  @@index([productId, changedAt])
  @@map("product_price_changes")
}
