// Hydromart payment-service data model (PRD Module 5, Payments).
// Owns the payment record for an order and its refunds. Linked to an order by
// orderId only (loose coupling — the order-service owns the order itself).

generator client {
  provider = "prisma-client-js"
  // Service-local output so it never clobbers other services' @prisma/client.
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("PAYMENT_DATABASE_URL")
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
  EWALLET
  VA
}

// PENDING → PAID | FAILED | CANCELLED; PAID → REFUNDED. Terminal: FAILED,
// CANCELLED, REFUNDED. Online-paid cancellation goes through REFUNDED.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// HQ refund-approval state for a payment (feature 14a). NONE = no approval needed
// (refunded directly, under the HQ threshold). PENDING = queued for HQ review.
// APPROVED/REJECTED = decided by finance/super-admin.
enum RefundApproval {
  NONE
  PENDING
  APPROVED
  REJECTED
}

/// One payment attempt for an order. A new attempt is created if a prior one
/// failed/was cancelled; at most one PENDING/PAID row exists per order.
model Payment {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @db.Uuid
  customerId   String        @db.Uuid
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amount       Decimal       @db.Decimal(12, 2)
  /// Provider charge reference / VA number / QRIS payload. Null for CASH.
  reference    String?
  /// Human-readable payment instruction shown to the customer.
  instruction  String?
  /// Opaque provider payload snapshot (JSON string) for audit/reconciliation.
  gatewayData  String?
  /// K2.1: the transfer/QRIS receipt the customer uploads, as a stored file URL.
  ///
  /// The payment instruction has always told them to produce one ("show the payment proof
  /// to staff") and there was nowhere to put it, so the operator's only affordance was a
  /// blind "confirm paid". Stays nullable for good: CASH is witnessed at the counter or the
  /// door, e-wallet and VA are refused (O5), and even a TRANSFER customer may pay without
  /// uploading — which the operator must see as "not uploaded", not guess at.
  proofUrl     String?
  paidAt       DateTime?
  failedAt     DateTime?
  /// Depot that took the money, set only for a counter sale. A delivery order's payment
  /// is not booked against a depot here — the order already carries that. Without it the
  /// cash in one depot's drawer cannot be told apart from the network's.
  depotId      String?       @db.Uuid

  /// C2: the cashier's open shift when this counter payment was taken — the DRAWER, not
  /// just the depot. `sumDepotCash` used to sum a depot's cash over a time window, and two
  /// cashiers open at once each claimed the whole window: the same money against both
  /// tills, and the counter cash booked to the cash book twice.
  ///
  /// Null for every delivery payment (there is no till) and for counter payments taken
  /// before this column existed; the reader attributes those by the old window rule.
  /// Carried as data, not a relation — the shift lives in depot-service's database.
  cashierShiftId String?

  /// COD only: cash the customer handed over and the change given back, recorded
  /// at confirm time (design 7a). Null for online/transfer settlements.
  cashReceived Decimal?  @db.Decimal(12, 2)
  changeGiven  Decimal?  @db.Decimal(12, 2)

  refundedAt     DateTime?
  refundReason   String?
  refundedAmount Decimal?  @db.Decimal(12, 2)
  /// HQ refund-approval state. High-value refunds park at PENDING until decided.
  refundApproval RefundApproval @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  // Closing a cashier's shift sums this depot's PAID cash over the shift window.
  @@index([depotId, method, status, paidAt])
  @@index([cashierShiftId])
  @@index([refundApproval])
  // Audit DB-1: a partial UNIQUE index enforcing one active (PENDING/PAID) payment
  // per order is added by migration 20260718140500_payment_one_active_per_order
  // (Prisma can't express a partial unique index here). The initiate() pre-check is
  // the fast path; this index is the real race guard.
  @@map("payments")
}

/// Singleton tax & invoice settings (feature 19f). One active row; feeds the
/// invoice-template preview (24d). PPN %, price-inclusive toggle, invoice-number
/// format and the company's legal identity.
model TaxSettings {
  id               String   @id @default(uuid()) @db.Uuid
  ppnPercent       Decimal  @db.Decimal(5, 2)
  priceIncludesTax Boolean  @default(true)
  /// How a fractional rupiah is resolved: HALF_UP (PER-11/2025 default), HALF_EVEN, DOWN.
  /// TEXT rather than an enum so a new convention needs no irreversible migration.
  taxRounding      String   @default("HALF_UP")
  invoiceFormat    String
  companyName      String
  npwp             String
  address          String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("tax_settings")
}
