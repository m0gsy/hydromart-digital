// Hydromart auth-service data model.
// Owns identity, OTP challenges, refresh-token sessions, and the security audit log.
// Secrets (OTP codes, refresh tokens) are stored HASHED, never in plaintext.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

/// Account role. Downstream services authorize against this claim (PRD §26 RBAC).
/// Depot chain: STAFF_DEPOT -> KEPALA_DEPOT (both locked to one depot) ->
/// ASSISTANT_SUPERVISOR -> SUPERVISOR -> MANAGER (each oversees a resolved SET of
/// depots) -> DIREKTUR and the office roles (network-wide).
enum Role {
  CUSTOMER
  STAFF_DEPOT
  KEPALA_DEPOT
  ASSISTANT_SUPERVISOR
  SUPERVISOR
  MANAGER
  DIREKTUR
  FRANCHISE_OWNER
  HEAD_OFFICE
  FINANCE
  HR
  MARKETING
  SUPER_ADMIN
}

/// A SUPER_ADMIN edit to the compiled RBAC matrix in @hydromart/access.
///
/// ONE row per CHANGED capability, holding the full replacement role list. A capability
/// with no row keeps the default shipped in the code, so an empty table is exactly
/// today's behaviour and there is nothing to seed or keep in sync. Resetting a
/// capability is a DELETE, and a capability added in a later release works with no
/// migration at all.
model CapabilityOverride {
  /// Capability name, validated against the compiled map before it is written.
  capability String   @id
  /// Full replacement role list. An empty list means "SUPER_ADMIN only" — the
  /// superuser short-circuit sits above this lookup and cannot be edited away.
  roles      Role[]
  updatedBy  String?  @db.Uuid
  updatedAt  DateTime @updatedAt

  @@map("capability_overrides")
}

/// Lifecycle of an account.
enum CustomerStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

/// Why an OTP was issued.
enum OtpPurpose {
  REGISTRATION
  LOGIN
}

/// An identity. In the auth context a "Customer" is any human principal; role
/// distinguishes customers from staff. Phone is the primary login handle (FR-001).
model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  /// E.164 phone number, unique across the platform (BR-001).
  phone        String         @unique
  email        String?        @unique
  fullName     String?
  role         Role           @default(CUSTOMER)
  status       CustomerStatus @default(PENDING_VERIFICATION)
  /// Google account subject id, set when a customer links Google Sign-In (FR-006).
  googleSub    String?        @unique
  /// Public URL of the customer's uploaded avatar image (null = default avatar).
  avatarUrl    String?
  /// Depot a staff member is assigned to (null for customers / unassigned staff). Used
  /// by the HQ depot-detail staff roster. No FK — depots live in depot-service.
  assignedDepotId String?     @db.Uuid
  /// Courier-only vehicle info: type (free text, e.g. "MOTOR"/"MOBIL") + plate number.
  /// Null for customers and staff without a vehicle. Set by staff on the invite form.
  vehicleType     String?
  plateNumber     String?
  phoneVerifiedAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  otpTokens     OtpToken[]
  refreshTokens RefreshToken[]

  @@index([status])
  @@index([assignedDepotId])
  @@map("customers")
}

/// A one-time password challenge. The code is stored as a bcrypt hash. Enforces
/// BR-002: valid <= 5 minutes, single-use, limited attempts.
model OtpToken {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @db.Uuid
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purpose    OtpPurpose
  /// bcrypt hash of the numeric code — never the plaintext code.
  codeHash   String
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([customerId, purpose])
  @@index([expiresAt])
  @@map("otp_tokens")
}

/// A refresh-token session (one per device). Tokens are hashed at rest and rotated
/// on every use; reuse of a rotated token revokes the whole family (theft detection).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  customerId   String    @db.Uuid
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// sha-256 (HMAC) hash of the opaque refresh token.
  tokenHash    String    @unique
  /// Session family — a rotation chain shares one familyId.
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Points to the token that replaced this one on rotation.
  replacedById String?   @db.Uuid
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([customerId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Immutable security audit trail (Engineering Constitution: audit log required).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String?  @db.Uuid
  action     String
  success    Boolean
  ipAddress  String?
  userAgent  String?
  /// Non-sensitive structured context (never store secrets/PII beyond identifiers).
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// UU PDP tahap 1 (item 13): a data-subject's request to export or delete their data.
/// Status/type are TEXT rather than Postgres enums — a future right (consent withdrawal)
/// must not need an irreversible enum migration to be added.
model DataSubjectRequest {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @db.Uuid
  /// EXPORT | DELETE
  type        String
  /// PENDING | COMPLETED | REJECTED
  status      String    @default("PENDING")
  /// Why the customer asked, or why HEAD OFFICE refused.
  reason      String?
  requestedAt DateTime  @default(now())
  /// The staff account that decided it — never the customer themselves.
  processedBy String?   @db.Uuid
  processedAt DateTime?

  @@index([customerId, requestedAt])
  @@index([status, requestedAt])
  @@map("data_subject_requests")
}

/// UU PDP tahap 2: append-only consent ledger. One row per decision per purpose — the
/// newest row for a purpose is the current answer, and the history is the proof of when
/// it changed. purpose/granted are plain columns (no enum) so a new purpose is a seed,
/// not an irreversible migration.
model ConsentRecord {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @db.Uuid
  /// TERMS | PRIVACY | MARKETING
  purpose         String
  granted         Boolean
  /// Which version of the text was agreed to.
  documentVersion String   @default("1.0")
  /// Where the decision was made: registration, account-settings, …
  source          String
  recordedAt      DateTime @default(now())

  @@index([customerId, purpose, recordedAt])
  @@map("consent_records")
}
