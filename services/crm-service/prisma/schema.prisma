// Hydromart crm-service data model (PRD Module 12 CRM/Broadcast Campaigns: FR-087
// Segmentation, FR-088 Campaign, FR-093 Push Notification, FR-094 WhatsApp Broadcast).
//
// SCOPE BOUNDARY (MVP): a campaign broadcasts to an EXPLICIT recipient list that marketing
// staff supply (phone required; customerId + name optional). Attribute-based segmentation
// by tier/geography (FR-087) needs a cross-service customer directory that no staff
// customer-list endpoint exposes today, so it is DEFERRED — recipients are always the
// explicit list, never a fabricated/queried audience. WhatsApp is the only channel for now
// (PRD §19 Notification Matrix makes it the primary broadcast channel).

generator client {
  provider = "prisma-client-js"
  // Service-local output so it never clobbers other services' @prisma/client.
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("CRM_DATABASE_URL")
}

/// Campaign lifecycle. DRAFT until dispatched; SENDING while recipients are processed;
/// SENT once complete. Only a DRAFT campaign may be sent (re-send is rejected).
enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  /// Added ahead of the code that writes it (CRM-02 / CRM-04).
  COMPLETED_WITH_FAILURES
  CANCELLED
}

/// Broadcast channel. IN_APP is what campaigns use now — an inbox row plus best-effort
/// push, the same transport as transactional notifications. WHATSAPP is kept because
/// historical rows carry it and that is the truth about how they were delivered; nothing
/// writes it any more.
enum CampaignChannel {
  WHATSAPP
  IN_APP
}

/// Per-recipient delivery state within a campaign send.
/// B-17: SENDING is the CLAIM. The broadcast sweep moves a batch PENDING -> SENDING in
/// one conditional write, so a second tick cannot pick up the same recipients and message
/// a real customer twice. These rows are the queue; no external broker is involved.
enum RecipientStatus {
  PENDING
  SENDING
  SENT
  FAILED
  /// Added ahead of the code that writes it (CRM-02).
  SKIPPED
}

/// HD-17: who made a draft. AI = the AI web, through its closed draft endpoint.
enum DraftSource {
  STAFF
  AI
}

/// Delivery outcome of a single transactional notification.
enum NotificationStatus {
  SENT
  FAILED
}

/// A broadcast campaign to an explicit staff-supplied recipient list (FR-088/FR-094).
model Campaign {
  id              String              @id @default(uuid())
  name            String
  channel         CampaignChannel     @default(IN_APP)
  messageTemplate String
  status          CampaignStatus      @default(DRAFT)
  totalRecipients Int                 @default(0)
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  /// Auth subject (staff user id) that created the campaign.
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sentAt          DateTime?
  /// When the campaign becomes due. NULL = as soon as the sweep sees it, which is what
  /// every campaign meant before scheduling existed.
  scheduledFor    DateTime?
  /// HD-17: STAFF or AI. An AI campaign stays DRAFT until a person presses Kirim (that IS the approval).
  source          DraftSource         @default(STAFF)
  /// The AI web's X-AI-Suggestion-Id; unique, so a retried call answers the same row.
  aiSuggestionId  String?             @unique @db.Uuid
  /// Why the AI proposes this campaign, shown beside the draft.
  aiReason        String?
  /// sha256 of the whole AI request (depot, segment, text, schedule, reason, author): a replay must match it.
  aiRequestHash   String?
  /// HD-14: the depot a depot campaign was made for (NULL = network-wide or older). A quality hold on it stops the send.
  depotId         String?             @db.Uuid

  recipients CampaignRecipient[]

  /// B-17: the broadcast sweep's query shape — "still SENDING, oldest first". Without it
  /// the sweep scans the whole campaign table every two minutes.
  @@index([status, createdAt])
  /// Partial: only scheduled rows need the due-check, and they are the minority.
  @@index([scheduledFor])
  /// HD-6 H4 part 2: campaigns finished inside a month, and any still sending (O-09).
  @@index([status, sentAt])
  @@map("campaigns")
}

/// One recipient row per campaign. `customerId` is optional (a recipient may not be a
/// registered customer); `phone` is required and unique within the campaign.
model CampaignRecipient {
  id         String          @id @default(uuid())
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  customerId String?
  phone      String
  name       String?
  status     RecipientStatus @default(PENDING)
  error      String?
  sentAt     DateTime?
  /// CRM-9: which sweep holds a SENDING row, and since when. A row held past the claim
  /// window by a sweep that died is claimable again instead of stuck forever.
  claimToken String?
  claimedAt  DateTime?
  createdAt  DateTime        @default(now())

  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

/// Urgency of a depot broadcast — URGENT surfaces a banner in the courier inbox (design 8a).
/// SCHEDULED ("Terjadwal") is a visual tier for planned notices (label only — no deferred send).
enum BroadcastLevel {
  INFO
  URGENT
  SCHEDULED
}

/// An operational announcement pushed by depot ops to every courier at a depot (design 8a).
/// Unlike a Campaign (customer WhatsApp blast to an explicit list), this is an in-app inbox
/// message scoped by `depotId`; couriers read it in the app and their reads are tracked.
model DepotBroadcast {
  id        String               @id @default(uuid())
  depotId   String
  title     String
  body      String
  level     BroadcastLevel       @default(INFO)
  /// Auth subject (depot-ops user id) that posted the broadcast.
  createdBy String
  createdAt DateTime             @default(now())

  reads DepotBroadcastRead[]

  @@index([depotId, createdAt])
  @@map("depot_broadcasts")
}

/// One row per courier who has opened a broadcast — the read receipt (created lazily on read).
model DepotBroadcastRead {
  id          String         @id @default(uuid())
  broadcast   DepotBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  broadcastId String
  courierId   String
  readAt      DateTime       @default(now())

  @@unique([broadcastId, courierId])
  @@index([courierId])
  @@map("depot_broadcast_reads")
}

/// An event-triggered transactional WhatsApp notification (FR-093/FR-094). Append-only
/// audit trail of automated messages fired by upstream services on lifecycle events.
model Notification {
  id         String             @id @default(uuid())
  event      String
  customerId String?
  phone      String
  message    String
  status     NotificationStatus @default(SENT)
  error      String?
  /// O1: the in-app screen a tap on this row opens. Null = nothing to open, and the
  /// client keeps the row as plain text rather than a link that goes nowhere.
  destination String?
  /// O6: the depot an operational notification belongs to. Null for customer rows and
  /// for every row written before the ops feed learned to scope itself per depot.
  depotId    String?
  /// A key the SENDER derives from the event it is reporting; unique, so a retried send is a no-op.
  /// Null for rows without one (every row before this column, every caller that sends none).
  dedupeKey  String?            @unique
  createdAt  DateTime           @default(now())

  opsReads OpsNotificationRead[]

  @@index([customerId, createdAt])
  /// The ops centre feed reads "these event types, newest first" — no customer filter,
  /// so the index above cannot serve it (audit DB-3).
  @@index([event, createdAt])
  @@map("notifications")
}

/// One row per staff member who has read an operational notification. The audit row above
/// stays append-only and shared across the whole ops centre, so read state cannot live on
/// it — a manager marking an alert read must not clear it for the operator next to them.
model OpsNotificationRead {
  id             String       @id @default(uuid())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String
  /// Auth subject (staff user id) that read it.
  staffId        String
  readAt         DateTime     @default(now())

  @@unique([notificationId, staffId])
  @@index([staffId])
  @@map("ops_notification_reads")
}

/// A browser Web Push subscription (RFC 8291) owned by a customer/driver. One row per
/// device endpoint; the keys encrypt the push payload. Pruned when the push service
/// reports the endpoint gone (404/410).
/// Despite the name, this holds BOTH transports (F4). A browser row stores its push
/// service URL in `endpoint`; an Android device stores `fcm:<registration token>` and
/// leaves `p256dh`/`auth` empty, because FCM encrypts the transport itself.
///
/// A prefix rather than a new model on purpose: `pending_migrations()` in
/// deploy-common.sh enforces "schema ships one release before its reader", so a new
/// table would be two releases where this is one. The same trick the water-meter unit
/// column already uses. The price is exactly this comment.
model WebPushSubscription {
  id         String   @id @default(uuid())
  customerId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@map("web_push_subscriptions")
}

/// A named audience definition (design 21d "Buat segment"). The conditions are the
/// SegmentFilter contract as JSON rather than a column each: that contract already grew
/// twice (activity conditions, then named customerIds), and a column per condition means a
/// migration every time it grows again — plus rows written under the older shape.
model SavedSegment {
  id         String   @id @default(uuid())
  name       String   @unique
  conditions Json
  /// Auth subject (staff user id) that saved it.
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("saved_segments")
}

// ---- WhatsApp number 1 (HD-12 / HD-13). Schema only in this release: nothing reads or writes
// these tables yet (deploy-common.sh pending_migrations: "schema ships one release before its reader").

/// The per-number consent ledger, append-only: the current state of a (phone, purpose) is its
/// newest row, and no row at all means "never asked", which is not "refused". `seq` is the cursor
/// the AI web pulls the STOP list by. auth-service's per-customer ledger is untouched: a number
/// needs a channel, a legal entity and a source, and a walk-in number has no account.
model WaConsent {
  id          String   @id @default(uuid())
  seq         BigInt   @unique @default(autoincrement())
  /// Digits only, `62...`, no plus (normalizeWaPhone).
  phone       String
  customerId  String?
  /// '1' | '2'
  waNumber    String
  /// 'UTILITY' | 'MARKETING'
  purpose     String
  channel     String   @default("WHATSAPP")
  /// PT name at the time of the consent (WA_LEGAL_ENTITY_NAME).
  legalEntity String
  granted     Boolean
  textVersion String
  /// 'APP' | 'CASHIER_QR' | 'KEYWORD' | 'AIWEB' | 'STAFF_REVOKE' | 'ERASURE'
  source      String
  /// Opt-in code id, Meta wamid or AI web event id; (source, sourceRef) makes a replay a no-op.
  sourceRef   String?
  depotId     String?
  recordedAt  DateTime @default(now())

  @@unique([source, sourceRef])
  @@index([phone, purpose, recordedAt(sort: Desc)])
  @@index([customerId, purpose, recordedAt(sort: Desc)])
  @@map("wa_consents")
}

/// A single-use code the customer sends to number 1 (`DAFTAR <code>`): it links a phone to a
/// customer or a cashier's counter. Claimed by one conditional UPDATE.
model WaOptInCode {
  id         String    @id @default(uuid())
  code       String    @unique
  /// 'CASHIER' | 'SELF'
  kind       String
  customerId String?
  depotId    String?
  createdBy  String
  expiresAt  DateTime
  usedAt     DateTime?
  usedPhone  String?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
  @@map("wa_opt_in_codes")
}

/// Outbound log and outbox for number 1. `dedupeKey` (`wa:` + the notification's key) makes a
/// retried event unable to send twice; `skipReason` tells HQ why nothing left.
model WaMessage {
  id             String    @id @default(uuid())
  notificationId String?
  dedupeKey      String    @unique
  customerId     String?
  phone          String
  waNumber       String
  /// 'UTILITY' | 'MARKETING' | 'AUTHENTICATION' | 'SERVICE'
  category       String
  templateName   String
  language       String
  /// The rendered parameters only.
  vars           Json
  /// 'QUEUED' | 'SENT' | 'DELIVERED' | 'READ' | 'FAILED' | 'CANCELLED' | 'SKIPPED'
  status         String
  /// 'OFF' | 'PAUSED' | 'NO_CONSENT' | 'STOPPED' | 'CAP' | 'TEMPLATE_NOT_APPROVED' | 'PEER_STOP_UNKNOWN' | 'NO_PHONE'
  skipReason     String?
  /// Meta's wamid.
  metaMessageId  String?   @unique
  errorCode      String?
  error          String?
  attempts       Int       @default(0)
  /// localMonthKey of creation (WIB).
  monthKey       String
  claimToken     String?
  claimedAt      DateTime?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  failedAt       DateTime?

  @@index([status, createdAt])
  @@index([monthKey, category])
  @@index([phone, createdAt])
  @@map("wa_messages")
}

/// Inbound webhook dedupe: the key (`wamid`, or `wamid:status`) only. No body is kept.
model WaInboundEvent {
  eventKey   String   @id
  kind       String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
  @@map("wa_inbound_events")
}

/// Monthly message cap per number and category. No row = cannot send (fail closed). `rateIdr`
/// is the owner's estimate from Meta's official price list; nothing guesses it.
model WaCap {
  waNumber        String
  category        String
  monthlyMessages Int
  rateIdr         Decimal? @db.Decimal(12, 2)
  monthlyCostIdr  Decimal? @db.Decimal(14, 2)
  /// Kill switch per row.
  paused          Boolean  @default(false)
  updatedBy       String?
  updatedAt       DateTime @default(now()) @updatedAt

  @@id([waNumber, category])
  @@map("wa_caps")
}

/// What was handed to Meta this month (WIB), per number and category. No personal data: kept 24 months.
model WaCostCounter {
  waNumber  String
  monthKey  String
  category  String
  messages  Int       @default(0)
  costIdr   Decimal   @default(0) @db.Decimal(14, 2)
  warnedAt  DateTime?
  stoppedAt DateTime?
  updatedAt DateTime  @default(now()) @updatedAt

  @@id([waNumber, monthKey, category])
  @@map("wa_cost_counters")
}

/// Approval state of a Meta template. Which event maps to which template and parameter order is
/// code (WA_TEMPLATE_SPECS), so a template cannot be sent with the wrong parameters.
model WaTemplate {
  id             String   @id @default(uuid())
  name           String
  language       String
  /// NotificationEvent name, null for a template no event sends.
  event          String?
  category       String
  bodyParams     Int
  metaTemplateId String?
  /// 'DRAFT' | 'SUBMITTED' | 'APPROVED' | 'REJECTED' | 'PAUSED'
  status         String   @default("DRAFT")
  statusReason   String?
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([name, language])
  @@map("wa_templates")
}

/// Last time the AI web (number 2) pulled the STOP list; a stale peer blocks marketing sends.
model WaPeerState {
  peer     String   @id
  lastOkAt DateTime
  lastSeq  BigInt   @default(0)

  @@map("wa_peer_state")
}
