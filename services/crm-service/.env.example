NODE_ENV=development
CRM_SERVICE_PORT=3012
CRM_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_crm?schema=public
# JWT_ACCESS_SECRET & INTERNAL_SERVICE_KEY are shared across every service.
# Set them ONCE in the repo-root .env (each service loads it via the ../../.env
# fallback in ConfigModule). Do NOT redefine them here — divergent copies are
# exactly what broke cross-service auth before (see hydromart-prod-boot-findings).
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
# customer-service base URL for FR-087 attribute segmentation. Blank disables segment targeting.
CUSTOMER_SERVICE_URL=http://localhost:3002
# Web Push (design 7b). Blank = push disabled. Generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@hydromart.id
# WhatsApp number 1 (HD-12/HD-13). All blank = off: nothing sent, webhook answers 404.
WA_ENABLED=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_ID_1=
WA_WABA_ID_1=
WA_GRAPH_VERSION=
WA_NUMBER_1_E164=
WA_LEGAL_ENTITY_NAME=
WA_PEER_MAX_AGE_SECONDS=
# HD-18: loyalty-service, for the point lots about to expire (customer reminders). Blank = that reminder answers 503.
LOYALTY_SERVICE_URL=http://localhost:3009
# order-service, for the subscriptions and unpaid orders the customer reminders cover.
ORDER_SERVICE_URL=http://localhost:3004
