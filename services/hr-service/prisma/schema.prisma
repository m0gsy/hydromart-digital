// Hydromart hr-service data model (HRIS Lite).
// Owns employees, face embeddings, face-recognition attendance, payroll (auto-generated
// from attendance), bonuses, deductions, performance reviews, and an HR audit trail.
//
// Cross-service references (depotId -> depot-service, authSubjectId -> auth-service) are
// plain UUID columns, NOT foreign keys: each microservice owns its own database.

generator client {
  provider = "prisma-client-js"
  // Service-local output so it never clobbers other services' @prisma/client.
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("HR_DATABASE_URL")
}

/// Employment classification. Drives the default salary policy (PRD Payroll).
/// It is a STATUS, not a job: `DEPOT_MANAGER` used to live here and made the tenure raise
/// depend on a status field, so a depot head could not also be on probation. The jabatan
/// moved to `Employee.role`.
enum EmploymentStatus {
  TRAINING
  PROBATION
  PERMANENT
}

/// Login role, mirroring auth-service's `Role` (and `@hydromart/access`). Kept as a local
/// column so payroll and the HR console can read someone's jabatan without a cross-service
/// call; auth-service stays the source of truth for what the role may actually DO.
enum Role {
  CUSTOMER
  STAFF_DEPOT
  KEPALA_DEPOT
  ASSISTANT_SUPERVISOR
  SUPERVISOR
  MANAGER
  DIREKTUR
  FRANCHISE_OWNER
  HEAD_OFFICE
  FINANCE
  MARKETING
  HR
  SUPER_ADMIN
}

/// How base pay is computed: per present-day vs a fixed monthly figure.
enum SalaryType {
  DAILY
  MONTHLY
}

/// Employee lifecycle (soft-delete: RESIGNED/INACTIVE stay in the table for history).
enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
}

/// Sex as printed on the KTP — two values because that is what the document carries.
enum Gender {
  MALE
  FEMALE
}

/// PPh 21 tax class: TK = single, K = married, the digit = dependants. Stored only; no
/// payroll rule reads it yet, income tax is still filed outside the app.
enum PtkpStatus {
  TK0
  TK1
  TK2
  TK3
  K0
  K1
  K2
  K3
}

/// Daily attendance outcome derived from check-in time + holiday/leave calendar.
enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  HOLIDAY
  /// Punch taken offline and synced too late to trust the device clock. Counts as nothing —
  /// payroll and reports whitelist PRESENT/LATE — until HR decides it.
  PENDING
}

/// Monthly payroll lifecycle. Only DRAFT is re-generatable; APPROVED/PAID are locked.
enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

/// A signed line on a payslip. BASE/ALLOWANCE/BONUS/ADJUSTMENT add; DEDUCTION subtracts.
/// ALLOWANCE counts into `gross` with BASE (it is fixed recurring pay), while BONUS is
/// variable and totalled separately.
enum PayrollItemKind {
  BASE
  BONUS
  DEDUCTION
  ADJUSTMENT
  ALLOWANCE
}

/// A recurring fixed addition to pay (transport, meal, position). Unlike a Bonus — one row
/// for one period — an allowance repeats every month until effectiveTo passes or it is
/// deactivated.
enum AllowanceType {
  TRANSPORT
  MEAL
  POSITION
  HOUSING
  OTHER
}

/// Company property handed to staff. Not consumables — anything tracked here is expected back.
enum AssetType {
  MOTORCYCLE
  SMARTPHONE
  UNIFORM
  LAPTOP
  PRINTER
  SCANNER
  OTHER
}

/// Where an asset is right now. AVAILABLE and RETURNED both mean "in the depot's hands", kept
/// apart so a brand-new item is distinguishable from one that came back.
enum AssetStatus {
  AVAILABLE
  ASSIGNED
  RETURNED
  MAINTENANCE
  LOST
}

/// What happened to an asset. Every one of these appends a row — the movement log is the
/// history, the asset row only ever holds the latest state.
enum AssetMovementKind {
  ASSIGN
  TRANSFER
  RETURN
  MAINTENANCE
  LOST
}

/// Leave categories. ANNUAL and PERMISSION consume the yearly quota; SICK and EMERGENCY are
/// recorded and paid but never deducted from it (see domain/leave.ts deductsQuota).
enum LeaveType {
  ANNUAL
  SICK
  PERMISSION
  EMERGENCY
}

/// Two-stage approval: the employee's manager first, then HR. Either stage can reject, and
/// the employee may cancel while it is still pending.
enum LeaveStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

/// Personal documents an employee file holds. KTP and KK are exactly the identity data
/// UU 27/2022 (PDP) regulates, which is why documents carry a retention purge path.
enum EmployeeDocumentType {
  KTP
  KK
  CONTRACT
  NPWP
  CERTIFICATE
  OTHER
}

/// How loudly an announcement reads in the console. Purely presentational.
enum AnnouncementLevel {
  INFO
  WARNING
  URGENT
}

/// Audience dimensions. The spec calls the fourth one "ROLE"; hr-service stores no auth role —
/// login roles live in auth-service — so the thing HR can actually target is the employee's
/// jabatan, `Employee.position`. Naming it POSITION keeps the column and the dimension honest.
enum AnnouncementDimension {
  COMPANY
  DEPOT
  DEPARTMENT
  POSITION
  EMPLOYEE
}

enum BonusType {
  ATTENDANCE
  PERFORMANCE
  SALES
  DEPOT
  MANUAL
}

enum DeductionType {
  LATE
  ABSENCE
  MANUAL
  CASH_ADVANCE
  OTHER
}

/// An internal employee. Identity is REUSED from auth-service when the person has a
/// login (authSubjectId = auth Customer.id); employees without a login carry a null.
model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  /// Human-facing staff code, unique network-wide (e.g. "HR-0001").
  employeeCode     String           @unique
  /// auth-service account id for self-service (My Attendance/Payroll/Profile). Unique,
  /// nullable — an employee may exist in HR before (or without) ever getting a login.
  authSubjectId    String?          @unique @db.Uuid
  fullName         String
  photoUrl         String?
  phone            String
  email            String?
  /// KTP number. Unique when present — two files with the same NIK is a data-entry mistake,
  /// not two people. Personal data under UU 27/2022, so it follows the retention purge.
  nik              String?          @unique
  birthDate        DateTime?        @db.Date
  gender           Gender?
  /// Home address, free text (KTP address). One line, not split — nothing computes on it.
  address          String?
  /// PPh 21 class. Stored for reporting; the payroll engine does not read it yet.
  ptkpStatus       PtkpStatus?
  /// End of a fixed-term contract. Null = open-ended. Never auto-expires anyone: a lapsed
  /// date is a reminder for HR, not a status change.
  contractEndDate  DateTime?        @db.Date
  /// Home depot (depot-service Depot.id). Drives DepotScopeGuard tenant isolation.
  /// Nullable: an Asisten SPV / SPV / Manager / Direktur is a full employee but sits above
  /// any single depot. Null means network-wide, never "every depot" — depot-scoped queries
  /// filter these rows OUT rather than matching them everywhere.
  depotId          String?          @db.Uuid
  position         String
  /// Login role (jabatan). Nullable for employees with no account, and for rows imported
  /// before this column existed. Payroll reads it for the depot-head tenure raise.
  role             Role?
  employmentStatus EmploymentStatus
  joinDate         DateTime         @db.Date
  /// Direct report's manager (Employee.id, same-service). Plain UUID, no relation nav — MVP.
  supervisorId     String?          @db.Uuid
  /// Assigned shift (Shift.id). Null = use depot/global default start-time.
  shiftId          String?          @db.Uuid
  /// Org unit (Department.id). Null = "Belum diatur" — existing rows are never guessed.
  departmentId     String?          @db.Uuid
  /// Tax + social-security ids (optional per PRD).
  npwp             String?
  bpjsKes          String?
  bpjsTk           String?
  salaryType       SalaryType
  /// Base pay in IDR. dailyRate for DAILY, monthlyRate for MONTHLY (the other is null).
  dailyRate        Decimal?         @db.Decimal(12, 2)
  monthlyRate      Decimal?         @db.Decimal(12, 2)
  bankName         String?
  bankAccount      String?
  emergencyName    String?
  emergencyPhone   String?
  status           EmployeeStatus   @default(ACTIVE)
  createdBy        String?          @db.Uuid
  updatedBy        String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  history          EmploymentHistory[]
  faceEmbeddings   FaceEmbedding[]
  attendance       Attendance[]
  bonuses          Bonus[]
  allowances       Allowance[]
  deductions       Deduction[]
  reviews          PerformanceReview[]
  payrolls         Payroll[]
  loans            Loan[]
  assets           EmployeeAsset[]
  leaveRequests    LeaveRequest[]
  leaveBalances    LeaveBalance[]
  documents        EmployeeDocument[]
  announcementReads AnnouncementRead[]
  shiftAssignments  ShiftAssignment[]

  @@index([depotId])
  @@index([status])
  @@index([departmentId])
  @@map("employees")
}

/// Append-only change log for an employee (status/position/salary transitions).
model EmploymentHistory {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @db.Uuid
  changeType    String
  fromValue     Json?
  toValue       Json?
  effectiveDate DateTime @db.Date
  note          String?
  createdBy     String?  @db.Uuid
  createdAt     DateTime @default(now())

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employment_history")
}

/// A stored 512-d ArcFace embedding for an enrolled face. Multiple per employee (frames).
model FaceEmbedding {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @db.Uuid
  /// L2-normalized 512-float embedding. Cosine similarity done in-service (no pgvector).
  vector         Float[]
  quality        Float    @default(0)
  sourcePhotoUrl String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([active])
  @@map("face_embeddings")
}

/// One row per employee per working day (idempotent). Check-in/out each stamp a photo,
/// a face-match score, and derive lateMinutes / workingMinutes / status.
model Attendance {
  id               String           @id @default(uuid()) @db.Uuid
  employeeId       String           @db.Uuid
  /// Copied from the employee. Null for staff who sit above a single depot (SPV and up) —
  /// a depot-scoped queue must skip them, not match them everywhere.
  depotId          String?          @db.Uuid
  workDate         DateTime         @db.Date
  checkInAt        DateTime?
  checkOutAt       DateTime?
  checkInPhotoUrl  String?
  checkOutPhotoUrl String?
  checkInScore     Float?
  checkOutScore    Float?
  /// GPS captured with each punch (FR + GPS + timestamp). Null on manual HR entries.
  checkInLat       Float?
  checkInLng       Float?
  checkOutLat      Float?
  checkOutLng      Float?
  lateMinutes      Int              @default(0)
  workingMinutes   Int?
  status           AttendanceStatus @default(ABSENT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  employee         Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  adjustments      AttendanceAdjustment[]

  @@unique([employeeId, workDate])
  @@index([depotId, workDate])
  @@index([workDate])
  @@map("attendance")
}

/// A manual correction to an attendance row (HR override), kept for audit.
model AttendanceAdjustment {
  id           String     @id @default(uuid()) @db.Uuid
  attendanceId String     @db.Uuid
  reason       String
  before       Json?
  after        Json?
  approvedBy   String?    @db.Uuid
  createdAt    DateTime   @default(now())

  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@map("attendance_adjustments")
}

/// Work shift definition (future-ready; MVP uses the config default 08:00 start).
model Shift {
  id        String   @id @default(uuid()) @db.Uuid
  depotId   String?  @db.Uuid
  name      String
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([depotId])
  @@map("shifts")
}

/// A weekly pattern: which shift is worked on each weekday. `pattern` is a JSON object keyed
/// "0".."6" with 0 = Sunday (matching Date.getUTCDay), each value a Shift.id or null for a
/// day off. A missing key is also a day off — an incomplete pattern must not invent a shift.
model ShiftRotation {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// Null = usable by every depot.
  depotId   String?  @db.Uuid
  pattern   Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ShiftAssignment[]

  @@index([depotId])
  @@map("shift_rotations")
}

/// Append-only: from `effectiveFrom` onward this employee works this shift (or rotation).
/// Never updated — `Employee.shiftId` overwrote without a trace, and "which shift was Budi on
/// in March" has to stay answerable when a late deduction is disputed.
model ShiftAssignment {
  id            String         @id @default(uuid()) @db.Uuid
  employeeId    String         @db.Uuid
  /// Exactly one of these is set: a fixed shift, or a weekly rotation.
  shiftId       String?        @db.Uuid
  rotationId    String?        @db.Uuid
  effectiveFrom DateTime       @db.Date
  note          String?
  createdBy     String?        @db.Uuid
  createdAt     DateTime       @default(now())

  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  rotation      ShiftRotation? @relation(fields: [rotationId], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
  @@map("shift_assignments")
}

/// A tracked piece of company property. `status` + `holderId` are the current state; how it
/// got there lives in AssetMovement, which is append-only.
model EmployeeAsset {
  id         String          @id @default(uuid()) @db.Uuid
  /// Human-facing asset tag, unique network-wide (e.g. "MTR-0001").
  code       String          @unique
  type       AssetType
  name       String
  brand      String?
  serialNo   String?
  /// Acquisition value in IDR — what a loss actually costs.
  value      Decimal?        @db.Decimal(12, 2)
  /// Owning depot (depot-service Depot.id). Drives DepotScopeGuard tenant isolation.
  depotId    String          @db.Uuid
  status     AssetStatus     @default(AVAILABLE)
  /// Employee holding it right now; null unless status is ASSIGNED.
  holderId   String?         @db.Uuid
  note       String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  holder     Employee?       @relation(fields: [holderId], references: [id], onDelete: SetNull)
  movements  AssetMovement[]

  @@index([depotId, status])
  @@index([holderId])
  @@map("employee_assets")
}

/// Append-only hand-over log. Rows are never updated or deleted: "who had the motorcycle in
/// March, and what condition did it come back in" must stay answerable after the fact.
model AssetMovement {
  id             String            @id @default(uuid()) @db.Uuid
  assetId        String            @db.Uuid
  kind           AssetMovementKind
  fromEmployeeId String?           @db.Uuid
  toEmployeeId   String?           @db.Uuid
  /// Free text at hand-over: "lecet di spakbor", "layar retak".
  condition      String?
  note           String?
  movedAt        DateTime          @default(now())
  createdBy      String?           @db.Uuid

  asset          EmployeeAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_movements")
}

/// Org unit an employee belongs to. depotId null = network-wide (Finance, HR); a depotId
/// scopes it to that depot (Gudang JKT-01), and only that depot's staff may be assigned to it.
model Department {
  id        String   @id @default(uuid()) @db.Uuid
  /// Human-facing code used by the bulk-import sheet, unique network-wide (e.g. "FIN").
  code      String   @unique
  name      String
  depotId   String?  @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([depotId])
  @@map("departments")
}

/// A recurring pay component. Deliberately NOT part of the overtime base — `domain/overtime.ts`
/// divides basic pay only, so two people on the same basic pay earn identical overtime whether
/// or not one of them draws an allowance.
model Allowance {
  id            String        @id @default(uuid()) @db.Uuid
  employeeId    String        @db.Uuid
  type          AllowanceType
  amount        Decimal       @db.Decimal(12, 2)
  effectiveFrom DateTime      @db.Date
  /// Null = open-ended (until deactivated).
  effectiveTo   DateTime?     @db.Date
  active        Boolean       @default(true)
  note          String?
  createdBy     String?       @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("allowances")
}

/// A leave application. `workingDays` is frozen at submit time from the calendar then in
/// force (holidays + weekly-off), so a holiday added later cannot silently change a decision
/// already taken on this row.
model LeaveRequest {
  id              String      @id @default(uuid()) @db.Uuid
  employeeId      String      @db.Uuid
  /// Copied from the employee so the approval queue can be depot-scoped without a join.
  /// Null for staff above a single depot — their request lands in the HQ/HR queue only.
  depotId         String?     @db.Uuid
  type            LeaveType
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  workingDays     Int
  reason          String
  attachmentUrl   String?
  status          LeaveStatus @default(PENDING_MANAGER)
  managerDecidedBy String?    @db.Uuid
  managerDecidedAt DateTime?
  hrDecidedBy     String?     @db.Uuid
  hrDecidedAt     DateTime?
  /// Why it was rejected — the employee sees this, so it is never optional on a rejection.
  decisionNote    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([depotId, status])
  @@map("leave_requests")
}

/// Yearly quota per employee. `usedDays` moves only on approval of a quota-consuming type.
model LeaveBalance {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid
  year       Int
  quotaDays  Int
  usedDays   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@map("leave_balances")
}

/// One uploaded file in an employee's personal file. Replacing a document does NOT overwrite
/// it: a new row is inserted and the old one is stamped supersededById, so the history of what
/// HR held and when is never lost. `fileKey` is what the retention purge deletes from storage —
/// dropping only the row would leave the KTP scan sitting in the bucket.
model EmployeeDocument {
  id             String               @id @default(uuid()) @db.Uuid
  employeeId     String               @db.Uuid
  type           EmployeeDocumentType
  fileUrl        String
  fileKey        String
  mimeType       String
  sizeBytes      Int
  /// 1 for the first upload of a type, then 2, 3… Each version is its own row.
  version        Int                  @default(1)
  /// Set on the OLD row when a replacement arrives, pointing at the newer document.
  supersededById String?              @db.Uuid
  uploadedBy     String?              @db.Uuid
  /// e.g. a contract end date or an ID expiry — null when the document does not expire.
  expiresAt      DateTime?            @db.Date
  createdAt      DateTime             @default(now())

  employee       Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, type])
  @@map("employee_documents")
}

/// One message to a resolved set of staff. `publishedAt` is what makes it visible AND what
/// makes it sent — a draft with a future `scheduledAt` sits here untouched until the
/// publish-due sweep runs, exactly like order-service's expireAbandoned. No cron inside.
model Announcement {
  id           String            @id @default(uuid()) @db.Uuid
  title        String
  body         String
  level        AnnouncementLevel @default(INFO)
  /// Null = publish immediately on create. A future value waits for the sweep.
  scheduledAt  DateTime?
  publishedAt  DateTime?
  /// Recipients frozen at publish time. Read rate must not drift when someone is hired
  /// or resigns a month later — the denominator is who it actually went to.
  audienceSize Int               @default(0)
  createdBy    String?           @db.Uuid
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  targets      AnnouncementTarget[]
  reads        AnnouncementRead[]

  @@index([publishedAt])
  @@index([scheduledAt])
  @@map("announcements")
}

/// One audience rule. Several rows OR together, and overlapping rows must not double-send —
/// that dedup is the whole point of resolving the audience in domain/announcement.ts.
model AnnouncementTarget {
  id             String                @id @default(uuid()) @db.Uuid
  announcementId String                @db.Uuid
  dimension      AnnouncementDimension
  /// Depot id, department id, position text, or employee id. Null for COMPANY (everyone).
  value          String?

  announcement   Announcement          @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@map("announcement_targets")
}

/// Read receipt. Unique per (announcement, employee): marking twice is not two reads.
model AnnouncementRead {
  id             String       @id @default(uuid()) @db.Uuid
  announcementId String       @db.Uuid
  employeeId     String       @db.Uuid
  readAt         DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([announcementId, employeeId])
  @@index([employeeId])
  @@map("announcement_reads")
}

/// Non-working day. depotId null = network-wide (national) holiday.
model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  name      String
  depotId   String?  @db.Uuid
  createdAt DateTime @default(now())

  @@unique([date, depotId])
  @@index([date])
  @@map("holidays")
}

/// A month's payroll for one employee (idempotent per period).
model Payroll {
  id              String        @id @default(uuid()) @db.Uuid
  employeeId      String        @db.Uuid
  /// "YYYY-MM".
  periodMonth     String
  status          PayrollStatus @default(DRAFT)
  gross           Decimal       @default(0) @db.Decimal(12, 2)
  totalBonus      Decimal       @default(0) @db.Decimal(12, 2)
  totalDeduction  Decimal       @default(0) @db.Decimal(12, 2)
  net             Decimal       @default(0) @db.Decimal(12, 2)
  presentDays     Int           @default(0)
  approvedBy      String?       @db.Uuid
  approvedAt      DateTime?
  paidAt          DateTime?
  createdBy       String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items           PayrollItem[]

  @@unique([employeeId, periodMonth])
  @@index([periodMonth, status])
  @@map("payrolls")
}

/// A signed payslip line (see PayrollItemKind).
model PayrollItem {
  id        String          @id @default(uuid()) @db.Uuid
  payrollId String          @db.Uuid
  kind      PayrollItemKind
  label     String
  amount    Decimal         @db.Decimal(12, 2)
  sourceRef String?
  createdAt DateTime        @default(now())

  payroll   Payroll         @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
  @@map("payroll_items")
}

model Bonus {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @db.Uuid
  type        BonusType
  amount      Decimal   @db.Decimal(12, 2)
  /// "YYYY-MM" the bonus applies to.
  periodMonth String
  note        String?
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now())

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, periodMonth])
  @@map("bonuses")
}

model Deduction {
  id          String        @id @default(uuid()) @db.Uuid
  employeeId  String        @db.Uuid
  type        DeductionType
  amount      Decimal       @db.Decimal(12, 2)
  periodMonth String
  note        String?
  createdBy   String?       @db.Uuid
  createdAt   DateTime      @default(now())

  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, periodMonth])
  @@map("deductions")
}

model PerformanceReview {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String   @db.Uuid
  periodMonth      String
  /// Final weighted score, 0–100.
  score            Decimal  @db.Decimal(5, 2)
  /// The three components behind it. NULL means "not measurable this period" (no scheduled
  /// working days, nobody attended, no sales target) — deliberately not 0, which would read
  /// as a failure the employee never had a chance to avoid. See domain/performance-score.ts.
  attendanceScore  Decimal? @db.Decimal(5, 2)
  disciplineScore  Decimal? @db.Decimal(5, 2)
  salesScore       Decimal? @db.Decimal(5, 2)
  /// The raw inputs and the effective weights, kept so an old review stays explainable
  /// after the weights are retuned.
  metrics          Json     @default("{}")
  reviewerId       String?  @db.Uuid
  note             String?
  /// The manager's own words, kept apart from `note` so a recomputation never overwrites it.
  managerNote      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodMonth])
  @@index([employeeId])
  @@map("performance_reviews")
}

/// A configurable automatic-bonus rule (Rule-F). depotId null = network-wide default.
/// metric/op/rewardKind are validated string enums (see domain/bonus-rules.ts).
model BonusRule {
  id          String    @id @default(uuid()) @db.Uuid
  depotId     String?   @db.Uuid
  bonusType   BonusType
  name        String
  metric      String
  op          String
  threshold   Decimal   @db.Decimal(14, 2)
  rewardKind  String
  rewardValue Decimal   @db.Decimal(14, 2)
  active      Boolean   @default(true)
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([depotId, active])
  @@map("bonus_rules")
}

/// An employee loan / kasbon repaid via auto payroll deductions (Rule-G). The per-period
/// deduction is derived purely from these terms (domain/loan.ts), so there is no mutable
/// remaining column — payroll re-generation stays idempotent. `active=false` stops deducting.
model Loan {
  id                String   @id @default(uuid()) @db.Uuid
  employeeId        String   @db.Uuid
  principal         Decimal  @db.Decimal(14, 2)
  installmentAmount Decimal  @db.Decimal(14, 2)
  /// First period the installment applies, "YYYY-MM".
  startPeriod       String
  note              String?
  active            Boolean  @default(true)
  createdBy         String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, active])
  @@map("loans")
}

/// HR audit trail: who changed what. Written by an interceptor on every mutation.
model AuditLog {
  id       String   @id @default(uuid()) @db.Uuid
  actorId  String?  @db.Uuid
  action   String
  entity   String
  entityId String?
  before   Json?
  after    Json?
  ip       String?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([at])
  @@map("audit_logs")
}

/// Business-tunable settings (SalaryConfiguration): GLOBAL default + optional per-DEPOT
/// override. Same shape as the other services' service_settings table.
model ServiceSetting {
  id        String   @id @default(uuid()) @db.Uuid
  scope     String
  depotId   String?  @db.Uuid
  key       String
  value     String
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // H-11: also two PARTIAL unique indexes, added in migration
  // 20260803160000_service_settings_unique and invisible to Prisma, which cannot express a
  // WHERE on an index: one key per depot, and one key globally. A plain @@unique here would
  // not constrain the GLOBAL rows — depotId is null on those and Postgres treats every NULL
  // as distinct. The repository upserts against them by catching the violation.
  @@index([scope, depotId])
  @@map("service_settings")
}
