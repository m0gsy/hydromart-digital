NODE_ENV=development
CUSTOMER_SERVICE_PORT=3002
CUSTOMER_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_customer?schema=public
# JWT_ACCESS_SECRET & INTERNAL_SERVICE_KEY are shared across every service.
# Set them ONCE in the repo-root .env (each service loads it via the ../../.env
# fallback in ConfigModule). Do NOT redefine them here — divergent copies are
# exactly what broke cross-service auth before (see hydromart-prod-boot-findings).
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
MAX_ADDRESSES_PER_CUSTOMER=20
# Birthday promo (FR-091). Blank LOYALTY_SERVICE_URL disables the sweep.
LOYALTY_SERVICE_URL=http://localhost:3009
BIRTHDAY_REWARD_POINTS=250
# CRM lifecycle (Fase 4). Blank ORDER_SERVICE_URL → CRM screens show no order data
# (segments/follow-ups empty). Thresholds are days; defaults shown.
ORDER_SERVICE_URL=http://localhost:3004
CRM_NEW_DAYS=30
CRM_ACTIVE_DAYS=30
CRM_FOLLOWUP_DAYS=60

# Bulk customer/reseller import pre-registers phones through auth-service's internal
# route. Blank -> every import row fails (503).
AUTH_SERVICE_URL=http://localhost:3001

# B2B prospects (AREA-1): HMAC-SHA256 key of the do-not-contact list. The list stores only a keyed hash of
# the phone / the name plus 1 km cell, never the number or the name. Min 32 chars. NEVER ROTATE IT: every stored
# hash would stop matching and suppressed businesses could be imported again. Required: the service will not boot without it.
PROSPECT_DNC_HMAC_KEY=change-me-prospect-dnc-hmac-key-32chars
# B2B prospects (AREA-1b): metres from the pin within which a salesperson's GPS check-in is accepted (and the GPS accuracy
# must be inside it too). Default 200.
PROSPECT_VISIT_RADIUS_M=200
