// Hydromart customer-service data model (PRD Module 2).
// Owns customer profile extension, delivery addresses, and notification prefs.
// Keyed by customerId — the identity id issued by auth-service.

generator client {
  provider = "prisma-client-js"
  // Custom output so this service's client does not clobber other services'
  // clients in the hoisted node_modules/@prisma/client.
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("CUSTOMER_DATABASE_URL")
}

enum MembershipTier {
  BASIC
  SILVER
  GOLD
}

/// Mirrors payment-service's PaymentMethod enum (duplicated per-service, as with
/// MembershipTier). Type of a saved, reusable payment instrument.
enum SavedPaymentType {
  CASH
  TRANSFER
  QRIS
  EWALLET
  VA
}

/// Profile extension for a customer. One row per identity, lazily created.
model CustomerProfile {
  customerId     String         @id @db.Uuid
  membershipTier MembershipTier @default(BASIC)
  pointBalance   Int            @default(0)
  favoriteDepotId String?       @db.Uuid
  /// Date of birth (day precision) — drives the birthday promo (FR-091). Optional.
  birthdate      DateTime?      @db.Date
  /// Year of the last birthday reward grant; makes the sweep idempotent (one grant per year).
  lastBirthdayRewardYear Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  /// The depot CRM lists every customer whose favourite depot is this one, on every
  /// page open. Without this the query is a sequential scan of the whole customer
  /// base (audit DB-2); the primary key on customerId does nothing for it.
  @@index([favoriteDepotId])
  @@map("customer_profiles")
}

/// A delivery address. BR-004: max 20 per customer. Exactly one is primary.
model Address {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @db.Uuid
  label         String
  recipientName String
  phone         String
  addressLine   String
  city          String
  // Kept as a column and never dropped: order snapshots and CRM segmentation still read
  // historical values. Nullable because the form stopped asking for it — see migration
  // 20260901090000_address_province_optional.
  province      String?
  postalCode    String?
  latitude      Float?
  longitude     Float?
  // Free-text landmark / patokan the customer adds ("pagar hijau sebelah warung Bu Ani").
  // Optional; flows to the courier via the per-order note at checkout.
  notes         String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
  // Audit DB-2: a partial UNIQUE index enforcing one primary per customer is added by
  // migration 20260718141000_one_primary_address (Prisma can't express a partial
  // unique index here). Pairs with the transactional AddressRepository.setPrimaryExclusive.
  @@map("addresses")
}

/// A saved, reusable payment instrument (spec 4f Account → Metode pembayaran).
/// Management-only — checkout still selects a per-transaction method. Exactly one
/// default per customer; the first saved becomes the default.
model SavedPaymentMethod {
  id               String           @id @default(uuid()) @db.Uuid
  customerId       String           @db.Uuid
  type             SavedPaymentType
  /// Display label, e.g. "Cash on delivery" / "GoPay".
  label            String
  /// Masked instrument tail, e.g. "••••4821"; null for cash.
  maskedIdentifier String?
  isDefault        Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([customerId])
  // Audit (DB-2 pattern): a partial UNIQUE index enforcing one default per customer is
  // added by migration 20260718150000_one_default_payment_method (Prisma can't express a
  // partial unique index here). Pairs with PaymentMethodRepository.setDefaultExclusive.
  @@map("saved_payment_methods")
}

/// A favorited (wishlisted) product. One row per (customer, product). Scoped to the
/// caller's customerId; productId references a product owned by another service.
model Favorite {
  id         String   @id @default(uuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("favorites")
}

/// Per-customer notification channel preferences (PRD §27).
model NotificationPreference {
  customerId String   @id @db.Uuid
  push       Boolean  @default(true)
  email      Boolean  @default(true)
  whatsapp   Boolean  @default(true)
  /// Per-app fine-grained category mutes (design 7b courier toggles). Keyed map of
  /// category id → enabled, e.g. { "tasks": true, "promo": false }. Empty = all on.
  categories Json     @default("{}")
  /// K5.3: the language this customer reads ('id' | 'en'). Messages are rendered by
  /// crm-service, which has no browser to ask — without this column the app could be in
  /// English while every order update arrived in Indonesian.
  locale     String   @default("id")
  updatedAt  DateTime @updatedAt

  @@map("notification_preferences")
}

/// A bulk reseller ("agen"): an existing customer who buys in bulk from one home depot
/// and resells. Registry + monthly gallon target only — achievement volume is derived at
/// read time from order-service (mirrors DepotTarget: goals stored, actuals derived).
model ResellerProfile {
  customerId       String   @id @db.Uuid // = existing CustomerProfile.customerId
  homeDepotId      String   @db.Uuid
  /// Monthly target in gallons (units, not IDR). 0 = no target set.
  monthlyTargetQty Int      @default(0)
  /// Flat reseller discount percent off subtotal at checkout (0-100). 0 = no reseller price.
  discountPct      Int      @default(0)
  /// Depot SOP: flat rupiah per gallon (e.g. 5000), overriding discountPct when > 0.
  /// A percentage cannot express "every galon costs Rp5.000 whatever it lists at".
  flatGallonPriceIdr Int    @default(0)
  /// Registration photo of the agen (KTP/toko), on the shared public storage base URL.
  photoUrl         String?
  active           Boolean  @default(true)
  joinDate         DateTime @db.Date
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([homeDepotId])
  @@map("reseller_profiles")
}

/// K4.2: every change to what an agen pays, and when it takes effect.
///
/// Deactivation and a new price used to be a bare UPDATE: instant, unsigned, unannounced.
/// Nobody could answer "who dropped this agen to 0%" a week later, and the agen found out
/// standing at a till. This table is the answer to both halves — it is the audit trail AND
/// the schedule, because a scheduled change is just a row that has not been applied yet.
///
///   appliedAt = null   scheduled; `effectiveAt` is in the future and the sweep will apply it
///   appliedAt set      applied at that moment; the row is history
///
/// One row per FIELD changed, not per request: "discount 10 → 5 and deactivated" is two
/// facts, and a history that merges them cannot answer either question cleanly. Values are
/// TEXT so a boolean, a percent and a rupiah amount share one shape.
model ResellerPriceChange {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  /// The staff account that made the change. Never null: an unattributed money change is
  /// the thing this table exists to stop.
  changedBy   String   @db.Uuid
  /// discountPct | flatGallonPriceIdr | active
  field       String
  oldValue    String
  newValue    String
  /// When it takes (or took) effect. Equal to createdAt for an immediate change.
  effectiveAt DateTime
  /// Null while scheduled. Set the moment the profile row actually moved.
  appliedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([customerId, createdAt(sort: Desc)])
  /// The sweep's read: everything due and not yet applied.
  @@index([appliedAt, effectiveAt])
  @@map("reseller_price_changes")
}
