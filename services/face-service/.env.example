# face-service — local development. Production values come from the compose file and the
# root .env (the service key is the shared INTERNAL_SERVICE_KEY).
NODE_ENV=development
FACE_SERVICE_PORT=3019
# The two pinned opencv_zoo models (face_detection_yunet_2023mar.onnx,
# face_recognition_sface_2021dec.onnx). The image puts them in /app/models.
FACE_MODEL_DIR=/app/models
FACE_QUEUE_MAX=8
INTERNAL_SERVICE_KEY=change-me
