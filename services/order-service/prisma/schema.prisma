// Hydromart order-service data model (PRD Module 4, Cart → Checkout → Order).
// Owns the shopping cart and the order lifecycle. Prices and the delivery
// address are SNAPSHOTTED at checkout so historical orders never drift when the
// catalog or the customer's address book changes later.

generator client {
  provider = "prisma-client-js"
  // Service-local output so it never clobbers other services' @prisma/client.
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("ORDER_DATABASE_URL")
}

// BR-012 order lifecycle. CANCELLED is reachable only before DRIVER_ASSIGNED
// (BR-006); the sequence is otherwise strictly forward.
enum OrderStatus {
  CREATED
  CONFIRMED
  PREPARING
  DRIVER_ASSIGNED
  PICKED_UP
  ON_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  /// A counter sale reversed at the till the same day. Kept apart from CANCELLED: that is
  /// an order that never happened, this is one that happened and was undone.
  VOIDED
}

/// A line in a customer's active cart. One row per (customer, product).
model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  productId  String   @db.Uuid
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("cart_items")
}

/// A placed order. Money is stored in IDR with 2 decimals for consistency with
/// the catalog. Delivery address fields are a snapshot taken at checkout.
model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique
  customerId  String      @db.Uuid
  status      OrderStatus @default(CREATED)

  /// Fulfilling depot, resolved at checkout by delivery-address proximity
  /// (nearest active depot within its service radius). Null when the address
  /// has no coordinates or no depot covers it. Powers Top-Depot reporting (FR-098).
  depotId     String?     @db.Uuid

  subtotal    Decimal @db.Decimal(12, 2)
  deliveryFee Decimal @db.Decimal(12, 2)
  discount    Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  // Delivery address snapshot (BR: not editable after pickup — kept immutable).
  recipientName String
  phone         String
  addressLine   String
  city          String
  province      String
  postalCode    String?
  latitude      Float?
  longitude     Float?
  notes         String?

  /// Customer's preferred delivery time-window, a free-form client label
  /// (e.g. "2026-07-20 09:00-12:00"). Not slot-checked — display/reference only.
  deliveryWindow String?

  /// Cash sale recorded at the depot counter: no cart, no courier, no delivery fee.
  /// Reporting needs it — otherwise a zero-fee order looks like a broken delivery order.
  isWalkIn       Boolean @default(false)

  /// Display name of the assigned courier (set at DRIVER_ASSIGNED). Powers "antaran {name}".
  driverName    String?

  /// Assigned courier's phone (set at DRIVER_ASSIGNED), snapshotted from dispatch so
  /// the customer can call the driver from order tracking without a cross-service lookup.
  driverPhone   String?

  /// Customer-facing ETA, set at ON_DELIVERY by delivery-service (distance ÷ assumed
  /// urban speed). Null until the courier starts the run. Powers the tracking "tiba ~".
  estimatedArrivalAt DateTime?

  /// Amount refunded on this order, set by payment-service when a refund settles.
  /// Null = no refund. Powers per-depot refund reconciliation (22a).
  refundedAmount Decimal? @db.Decimal(12, 2)

  /// Counter void: when the sale was reversed and why. The reason is not optional in
  /// practice — a drawer that is short by a voided sale needs the till's own account of it.
  voidedAt     DateTime?
  voidReason   String?

  /// Client-supplied `Idempotency-Key` for the request that placed this order. A double
  /// tap or a retry after a timeout carries the same key and the unique below turns the
  /// second write into a no-op that returns this same row. Null for order paths with no
  /// caller to retry them (subscription sweeps).
  idempotencyKey String?

  /// D6: the subscription that produced this delivery, or null for every order a person
  /// placed themselves. Carried as data rather than a relation, the same way depotId is —
  /// a subscription removed for retention must not take its order history with it, and the
  /// order is the financial record of the two.
  ///
  /// Before this, the only link was the sweep's idempotency string `sub:<id>:<iso>`, which
  /// no read model exposed and nothing could query.
  subscriptionId String?

  items   OrderItem[]
  history OrderStatusHistory[]
  review  OrderReview?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// B3: when the order last ENTERED its current status — not when it was created.
  /// The stalled-order sweep needs the difference: an order placed a day ago and accepted
  /// by the depot a minute ago has been stuck for a minute, and `createdAt` says a day.
  /// Written by every transition; `order_status_history` remains the full audit trail.
  statusChangedAt DateTime @default(now())

  // Reporting + paginated list all filter/sort on createdAt; composites back the
  // customer-, status- and depot-scoped predicates (audit DB-3, DB-4). The three
  // single-column indexes these replaced were redundant: Postgres uses the leftmost
  // prefix of a composite for the same equality lookups, and every extra index is
  // another write to maintain on the busiest table in the system.
  @@index([createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([depotId, createdAt])
  // D6: "every delivery this subscription produced", newest first.
  @@index([subscriptionId, createdAt])
  // B3b: the stalled sweep filters and orders by (status, statusChangedAt). Built
  // CONCURRENTLY by scripts/create-indexes.sh — a plain build here would lock the busiest
  // table in the system for its whole duration (audit H-39).
  @@index([status, statusChangedAt])
  // B-13: one order per (buyer, idempotency key). Postgres treats every NULL as distinct,
  // so this only binds requests that actually sent a key.
  @@unique([customerId, idempotencyKey])
  @@map("orders")
}

/// A price-snapshotted order line. `unitPrice`/`productName`/`sku` are frozen at
/// checkout so the order total never changes if the catalog later does.
model OrderItem {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String  @db.Uuid
  productName String
  sku         String
  unit        String
  /// Snapshotted fill volume (ml) — same freeze rule as unitPrice. If the catalog
  /// later restates a galon as 19.2L, past orders still reconcile at the volume
  /// that was true when they were sold. Null = unmeasured, never zero litres.
  volumeMl    Int?
  /// Snapshotted galon flag. Drives the per-galon delivery fee and the gallon
  /// counts in depot reports — both used to be guessed from the `unit` string.
  isGallon    Boolean @default(false)
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

/// One depot's water-meter reading for one day. Operator writes it twice: the
/// opening number when the depot opens, the closing number when it shuts. The
/// difference is the litres of treated water that actually left the plant, which
/// is then reconciled against the litres the day's recorded sales account for.
///
/// The source (raw-water) pair is optional: filled in only by depots that also
/// meter their intake, and it yields the RO recovery percentage.
model MeterReading {
  id              String    @id @default(uuid()) @db.Uuid
  depotId         String    @db.Uuid
  readingDate     DateTime  @db.Date
  /// Cubic metres, as read off the dial. Litres are derived, never stored.
  openingM3       Decimal   @db.Decimal(12, 3)
  closingM3       Decimal?  @db.Decimal(12, 3)
  sourceOpeningM3 Decimal?  @db.Decimal(12, 3)
  sourceClosingM3 Decimal?  @db.Decimal(12, 3)
  openedBy        String    @db.Uuid
  openedAt        DateTime  @default(now())
  closedBy        String?   @db.Uuid
  closedAt        DateTime?
  /// Set when the variance alert has been sent, so correcting a typo and saving
  /// again does not fire a second alert for the same day.
  alertedAt       DateTime?
  note            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // One reading per depot per day — the upsert key for both the morning and the
  // evening write.
  @@unique([depotId, readingDate])
  @@index([depotId, readingDate])
  @@map("meter_readings")
}

/// Append-only audit of every status transition (BR-012 traceability).
model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  // Actor that made the change: a user id (UUID) OR a system service label
  // (e.g. 'payment-service' for the settled-payment auto-confirm). Plain text,
  // not @db.Uuid — a service name is not a UUID and Prisma would reject it.
  changedBy String?
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

enum SubscriptionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

/// Recurring galon delivery (spec 7b). A due ACTIVE subscription auto-places an
/// order for its single line, then advances nextDeliveryAt by the frequency.
model Subscription {
  id         String                @id @default(uuid()) @db.Uuid
  customerId String                @db.Uuid
  productId  String                @db.Uuid
  productName String
  unit       String
  quantity   Int
  frequency  SubscriptionFrequency
  status     SubscriptionStatus    @default(ACTIVE)
  nextDeliveryAt DateTime

  /// D2: consecutive failed sweep cycles. Reset to 0 on any success, so it measures a
  /// CURRENT outage rather than a lifetime tally — a plan that failed once a year ago and
  /// has delivered ever since is not in trouble.
  failureCount  Int      @default(0)
  /// When the current run of failures started mattering.
  lastFailureAt DateTime?
  /// What went wrong, in words, so a human has something to act on. The container log was
  /// the only record before this, and nobody reads it.
  lastFailure   String?

  // Delivery address snapshot used for every scheduled order.
  recipientName String
  phone         String
  addressLine   String
  city          String
  province      String
  postalCode    String?
  latitude      Float?
  longitude     Float?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status, nextDeliveryAt])
  @@map("subscriptions")
}

/// Customer rating of a completed order (spec 7c). One review per order.
model OrderReview {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @unique @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String   @db.Uuid
  rating     Int
  aspects    String[]
  comment    String?
  tipAmount  Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("order_reviews")
}

/// Per-depot/global overridable service settings (key-value, GLOBAL falls back to DEPOT).
model ServiceSetting {
  id        String   @id @default(uuid())
  scope     String   // 'GLOBAL' | 'DEPOT'
  depotId   String?  @map("depot_id")
  key       String
  value     String
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  // H-11: also two PARTIAL unique indexes, invisible to Prisma because it cannot express a
  // WHERE on an index: one key per depot, and one key globally. A plain @@unique here would
  // not constrain the GLOBAL rows — depotId is null on those and Postgres treats every NULL
  // as distinct. The repository upserts against them by catching the violation.
  //
  // They have existed since 20260724181000_service_settings; the audit's H-11 was true only of
  // hr-service, which gets them in 20260803160000_service_settings_unique.
  @@index([scope, depotId])
  @@map("service_settings")
}

/// H-10: durable outbox for the side effects that MUST happen when an order completes.
///
/// Stock consume, the loyalty award, the referral qualification and the franchise-owner
/// credit were all fire-and-forget HTTP calls behind a `.catch(() => {})`. A depot-service
/// blip meant the depot's checkout hold was never settled and its sellable stock drifted
/// down forever; a payout-service blip meant an owner was simply never paid for a sale.
/// Nothing retried, and the only trace was a log line.
///
/// Rows are written in the SAME transaction as the status change that earns them, so an
/// order can never be COMPLETED without its effects being owed somewhere durable. Every
/// handler is idempotent on the receiving side (keyed by order id), which is what makes
/// retrying safe.
model OutboxMessage {
  id        String   @id @default(uuid()) @db.Uuid
  /// Which effect this row owes. See OUTBOX_TOPICS in the application layer.
  topic     String
  /// The order the effect is for. The handler re-reads it, so nothing here can go stale.
  orderId   String   @db.Uuid
  status    String   @default("PENDING")
  attempts  Int      @default(0)
  /// Exponential backoff: the sweep only picks up rows due at or before now.
  nextAttemptAt DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One row per effect per order: re-running the completion cannot owe it twice.
  @@unique([topic, orderId])
  /// B10: the sweep's predicate. NOT a claim — nothing is locked here, deliberately:
  /// every outbox handler is idempotent per order, so overlapping sweeps cost a wasted
  /// call and never a double effect. The old wording promised a guarantee nobody made.
  @@index([status, nextAttemptAt])
  @@map("outbox_messages")
}
