// Hydromart depot-service data model (PRD Module 10 Depot Management + Module 9 Inventory).
// Owns depots (ownership type, operating hours, delivery zone/fee, holidays) and their
// per-depot stock lines (Air/Galon/Tutup/Segel/Produk) with an append-only movement ledger.

generator client {
  provider = "prisma-client-js"
  // Service-local output so it never clobbers other services' @prisma/client.
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DEPOT_DATABASE_URL")
}

/// Franchise (Waralaba) vs company-owned (HKP). PRD: every depot has exactly one type.
enum OwnershipType {
  WARALABA
  HKP
}

/// Stock line kinds (PRD FR-067..071). PRODUK lines reference the product catalog.
enum InventoryItemType {
  AIR
  GALON
  TUTUP
  SEGEL
  PRODUK
}

/// Ledger entry kind (PRD FR-072 adjustment, FR-073 opname; RECEIPT seeds initial stock;
/// SALE deducts sold quantities when an order completes).
enum StockMovementType {
  RECEIPT
  ADJUSTMENT
  OPNAME
  SALE
  /// CA-2-54: stock leaving this depot for another one. Written when the sender dispatches.
  TRANSFER_OUT
  /// CA-2-54: stock arriving from another depot. Written when the receiver confirms it.
  TRANSFER_IN
}

/// Lifecycle of a per-order stock hold (reserve at checkout -> release on cancel / consume on completion).
enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model Depot {
  id             String        @id @default(uuid()) @db.Uuid
  /// Human-facing short code, unique across the network (e.g. "JKT-01").
  code           String        @unique
  name           String
  ownershipType  OwnershipType
  address        String
  city           String
  province       String
  lat            Float
  lng            Float
  /// Service/delivery radius in km (FR-077/FR-078).
  serviceRadiusKm Float        @default(5)
  /// Drawn service area: [[{lat,lng},...], ...] (outer rings). Null = serve by serviceRadiusKm.
  serviceArea    Json?
  /// Flat delivery fee for this depot in IDR (FR-079).
  deliveryFee    Decimal       @db.Decimal(12, 2)
  /// Minimum order amount in IDR; per-depot policy. Null = no minimum.
  minOrderAmount Decimal?      @db.Decimal(12, 2)
  /// Franchise owner (account id) who manages this depot. Null = unassigned / company-run.
  ownerId        String?       @db.Uuid
  /// Assistant supervisor (auth account id) overseeing this depot; null = unassigned, which
  /// means HQ and up only. Written ONLY through the staff-hierarchy routes, never the depot
  /// PATCH — a manager must not be able to redraw their own scope.
  assistantSupervisorId String? @db.Uuid
  /// The depot's own WhatsApp number, for operational messages addressed to the depot
  /// rather than to a customer (SOP: the twice-daily sales update). Null = fall back to
  /// the HQ ops number.
  contactPhone   String?
  /// Per-depot payment destination shown to a paying customer (franchise model: money goes
  /// direct to each depot, manually confirmed, no gateway). All optional until an owner sets them.
  paymentBankName          String?
  paymentBankAccountNumber String?
  paymentBankAccountHolder String?
  /// URL of the depot's static QRIS image.
  paymentQrisImageUrl      String?
  /// Weekly operating hours (FR-076): { mon: {open,close}, ... }.
  operatingHours Json          @default("{}")
  /// Closure dates (FR-080): [{ date: "2026-08-17", label?: "..." }].
  holidays       Json          @default("[]")
  active         Boolean       @default(true)
  /// HD-21: the AI web CRM's prospect this depot was onboarded from; set by the activation PR.
  crmProspectId  String?       @db.Uuid
  /// HD-21: the legacy franchise application it came from, when there was one.
  franchiseApplicationId String? @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  /// HD-21: the CRM draft this depot was activated from.
  crmDraft       DepotDraft?

  inventory      InventoryItem[]
  gallonReturns  GallonReturn[]
  gallonIssues   GallonIssue[]
  gallonReminders GallonReminder[]
  // Console/manager models (DB-5): FK back-relations. Config models cascade on depot
  // delete; financial/audit models (POs, approvals, cashbook, disputes) restrict.
  priceOverrideProposals PriceOverrideProposal[]
  pricingRules           PricingRule[]
  incidents              Incident[]
  visits                 Visit[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  // CA-2-54: two sides of the same table, so a depot can list what it sent and what is
  // still on its way in.
  transfersSent          StockTransfer[] @relation("TransfersSent")
  transfersReceived      StockTransfer[] @relation("TransfersReceived")
  approvals              Approval[]
  shiftAssignments       ShiftAssignment[]
  depotTargets           DepotTarget[]
  cashbookEntries        CashbookEntry[]
  cashierShifts          CashierShift[]
  dailyCloses            DepotDailyClose[]
  monthlyCloses          DepotMonthlyClose[]
  orderDisputes          OrderDispute[]
  maintenanceItems       MaintenanceItem[]
  qualityHolds           DepotQualityHold[]
  labTests               DepotLabTest[]
  permits                DepotPermit[]
  wholesaleTiers         WholesaleTier[]
  subscriptions          Subscription[]
  huddleNotes            HuddleNote[]
  shiftHandovers         ShiftHandover[]
  serviceSettings        ServiceSetting[]
  owners                 DepotOwner[]
  /// HD-5: which legal entity this depot belongs to, by date.
  legalEntities          DepotLegalEntity[]
  fixedCosts             DepotFixedCost[]

  @@index([active])
  @@index([ownershipType])
  @@index([ownerId])
  @@index([assistantSupervisorId])
  @@map("depots")
}

/// Condition of returned empty gallons: reusable stock vs. damaged/retired.
enum GallonCondition {
  GOOD
  DAMAGED
}

/// Empty-gallon return / deposit refund ledger (PRD Module 11 retur galon).
/// One append-only row per return event at a depot: empties handed back and the
/// deposit refunded. Standalone ledger — not yet wired into GALON stock counts.
model GallonReturn {
  id              String          @id @default(uuid()) @db.Uuid
  depotId         String          @db.Uuid
  depot           Depot           @relation(fields: [depotId], references: [id], onDelete: Cascade)
  /// Customer who returned the empties (optional — walk-ins may be anonymous).
  customerId      String?         @db.Uuid
  /// Order the return happened against (set when a courier records it at delivery
  /// handover, design 2e; null for a walk-in counter return).
  orderId         String?         @db.Uuid
  /// Number of empty gallons handed back.
  quantity        Int
  condition       GallonCondition @default(GOOD)
  /// Deposit refunded to the customer in IDR (0 = no deposit / store credit).
  /// Courier-recorded returns derive this server-side (GALLON_DEPOSIT_IDR × quantity).
  depositRefunded Decimal         @db.Decimal(12, 2) @default(0)
  note            String?
  /// Staff member (or courier) who recorded the return.
  actorId         String
  /// DEP-07: the client's key for ONE manual submission. NULL on courier returns and old rows.
  idempotencyKey  String?
  createdAt       DateTime        @default(now())

  /// One return per (depot, key). NULL keys are distinct, so keyless rows never collide.
  @@unique([depotId, idempotencyKey], map: "gallon_returns_depotId_idempotencyKey_key")
  @@index([depotId, createdAt])
  /// MONEY-04: unique, not just indexed. The courier handover travels through the offline
  /// queue, which is at-least-once, and a bare create refunded the deposit twice on a
  /// retry. Postgres treats every NULL as distinct, so this refuses a second booking of
  /// the same order while leaving walk-in counter returns (orderId null) unconstrained —
  /// exactly the shape gallon_issues has carried since I1.
  @@unique([orderId], map: "gallon_returns_orderId_key")
  @@map("gallon_returns")
}

/// Empty-gallon issue / deposit-held ledger (PRD Module 11c — mirror of retur galon).
/// One append-only row per issue event at a depot: empties handed out on deposit.
/// "Galon di pelanggan / belum kembali" = SUM(issued.quantity) − SUM(returned.quantity).
/// Manual ledger — auto-ingest from an order-completed event is a future follow-up.
model GallonIssue {
  id          String   @id @default(uuid()) @db.Uuid
  depotId     String   @db.Uuid
  depot       Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  /// Customer who took the empties (optional — walk-ins may be anonymous).
  customerId  String?  @db.Uuid
  /// I1: the order this issue was booked from, when fulfilment wrote it. Null for a
  /// staff-entered issue, which is why the unique index below is partial. It exists to
  /// make the fulfilment write idempotent: a completion fan-out is at-least-once, and a
  /// second booking would inflate the deposit the depot appears to hold — and therefore
  /// what it later refunds.
  orderId     String?  @db.Uuid
  /// Number of empty gallons issued.
  quantity    Int
  /// I4: deposit held from the customer, in IDR (0 = no deposit).
  ///
  /// Decimal, matching `GallonReturn.depositRefunded` — every balance in this domain is
  /// `held − refunded`, and the two halves of one subtraction must not disagree about what
  /// a rupiah is. Widened from Int rather than narrowing the other side, because widening
  /// is additive and reversible.
  depositHeld Decimal  @db.Decimal(12, 2) @default(0)
  note        String?
  /// Staff member who recorded the issue.
  actorId     String
  /// DEP-07: the client's key for ONE manual submission. NULL on fulfilment rows and old rows.
  idempotencyKey String?
  createdAt   DateTime @default(now())

  /// One manual issue per (depot, key). NULL keys are distinct, so keyless rows never collide.
  @@unique([depotId, idempotencyKey], map: "gallon_issues_depotId_idempotencyKey_key")
  /// Total unique, and Prisma can see it — unlike the partial indexes on ServiceSetting.
  /// Postgres treats every NULL as distinct, so this refuses a second booking of the same
  /// order while leaving staff-entered rows (orderId null) unconstrained.
  @@unique([orderId], map: "gallon_issues_orderId_key")
  @@index([depotId, createdAt])
  @@map("gallon_issues")
}

/// When a depot last asked one customer to bring its gallons back.
///
/// The reminder sweep runs every morning; without this it would send an overdue customer the
/// same message every morning. One row per (depot, customer), overwritten on each reminder —
/// it answers "when did we last ask?", not "what did we ask", so it never grows past the number
/// of customers who have ever been late.
model GallonReminder {
  id         String   @id @default(uuid()) @db.Uuid
  depotId    String   @db.Uuid
  depot      Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  customerId String   @db.Uuid
  remindedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([depotId, customerId])
  @@map("gallon_reminders")
}

model InventoryItem {
  id           String            @id @default(uuid()) @db.Uuid
  depotId      String            @db.Uuid
  depot        Depot             @relation(fields: [depotId], references: [id], onDelete: Cascade)
  itemType     InventoryItemType
  /// Set only for PRODUK lines: the catalog product this line tracks.
  productId    String?           @db.Uuid
  /// Display label, e.g. "Air RO", "Galon 19L", or the product name for PRODUK lines.
  label        String
  unit         String
  quantity     Int               @default(0)
  /// Units held by ACTIVE order reservations. Sellable stock = quantity - reserved.
  reserved     Int               @default(0)
  minimumStock Int               @default(0)
  /// Per-depot sell price override in IDR (PRODUK lines only). Null = use the
  /// catalog base price. Lets franchise (WARALABA) depots price independently.
  sellPrice    Decimal?          @db.Decimal(12, 2)
  /// Set when the catalog product behind this line was deactivated. The line is kept —
  /// its movement history is the depot's record of what it once sold — but hidden from
  /// the operator list so a product nobody sells any more stops asking to be counted.
  /// Internal lookups (reserve/consume) ignore the flag: an order already in flight must
  /// still settle against the line it was placed on.
  hidden       Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  movements    StockMovement[]
  reservations StockReservation[]

  // Best-effort DB uniqueness for PRODUK lines (productId set). Non-PRODUK singletons
  // (productId NULL) slip past this because Postgres treats NULLs as distinct — they're
  // now also enforced by a partial unique index on (depotId, itemType) WHERE productId IS
  // NULL, added in migration 20260718170000_inventory_singleton_unique (DB-11; Prisma DSL
  // can't express a partial unique index, so it lives in raw SQL there).
  @@unique([depotId, itemType, productId])
  @@index([depotId])
  @@map("inventory_items")
}

/// A per-order hold on a stock line placed at checkout. Prevents overselling
/// between checkout and completion; released on cancel, consumed on completion.
model StockReservation {
  id        String            @id @default(uuid()) @db.Uuid
  itemId    String            @db.Uuid
  item      InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderId   String            @db.Uuid
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // One reservation per line per order (idempotent reserve/release/consume).
  @@unique([itemId, orderId])
  @@index([itemId])
  @@map("stock_reservations")
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  itemId         String            @db.Uuid
  item           InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type           StockMovementType
  /// Signed change applied to quantity (+receipt/positive adjust, -consume, opname variance).
  delta          Int
  quantityBefore Int
  quantityAfter  Int
  reason         String?
  /// User id of the staff member who recorded the movement.
  actorId        String
  /// Set only on SALE movements: the order that consumed this stock. Enables
  /// idempotent order->inventory deduction (a retried COMPLETED never double-deducts).
  orderId        String?           @db.Uuid
  createdAt      DateTime          @default(now())

  @@unique([itemId, orderId])
  // The fastest-growing table in the system, and every read of it is "this item's
  // ledger, newest first" or "this depot's movements of this type in a window"
  // (audit DB-1). The bare [itemId] index these replaced is the leftmost prefix of
  // the first composite, so nothing lost it.
  @@index([itemId, createdAt])
  @@index([type, createdAt])
  @@map("stock_movements")
}

/// Prospective-franchise application lifecycle (HQ approvals queue, design 5a/5b).
/// PENDING -> DOC_VERIFICATION -> SURVEY -> APPROVED / REJECTED.
enum FranchiseAppStage {
  PENDING
  DOC_VERIFICATION
  SURVEY
  APPROVED
  REJECTED
}

/// An HQ-reviewed application to open a new franchise (WARALABA) depot. The proposed
/// depot fields double as the onboard-form prefill returned on approval. The document
/// checklist (KTP&NPWP, location-ownership proof, capital deposit, field survey) is a
/// JSON map of item -> status, mirroring how the schema stores operatingHours/holidays.
model FranchiseApplication {
  id                      String            @id @default(uuid()) @db.Uuid
  applicantName           String
  applicantPhone          String
  /// Proposed depot short code (becomes the depot `code` on onboard).
  proposedCode            String
  proposedName            String
  city                    String
  province                String
  lat                     Float
  lng                     Float
  /// Applicant's stated investment (IDR).
  investmentAmount        Decimal           @db.Decimal(14, 2)
  /// Applicant's projected monthly revenue (IDR).
  projectedMonthlyRevenue Decimal           @db.Decimal(14, 2)
  /// { ktpNpwp, locationProof, capitalDeposit, fieldSurvey } each = PENDING|VERIFIED|REJECTED.
  checklist               Json              @default("{}")
  stage                   FranchiseAppStage @default(PENDING)
  /// The reason HQ typed when approving/rejecting; null when none was given.
  decisionReason          String?
  /// HD-8: the campaign codes of the first and the latest coded link the applicant's browser
  /// arrived by (`?src=`, else `?utm_source=`). The first never moves; the latest sits beside
  /// it. Null when no coded link was followed, and for every application before HD-8.
  firstSource             String?           @db.VarChar(64)
  lastSource              String?           @db.VarChar(64)
  /// HD-8: the Kebijakan Privasi version in force when the consent box was ticked; the
  /// moment is `submittedAt`. Null before HD-8: consent was required (CA-3-53), not recorded.
  privacyConsentVersion   String?
  submittedAt             DateTime          @default(now())
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  // Oldest-first SLA queue reads by (stage, submittedAt).
  @@index([stage, submittedAt])
  @@map("franchise_applications")
}

enum PricingAdjustType {
  PERCENT
  FIXED
  /// CA-2-35: the value IS the price, not a delta from it.
  ///
  /// PERCENT and FIXED are both relative — one multiplies the current price, the other adds
  /// to it — so the HQ form's "harga tetap" was stored as `target - basePrice` and drifted
  /// whenever the catalogue moved. The one adjust type whose whole promise is "this number
  /// and no other" was the one that did not keep it.
  ABSOLUTE
}

/// HQ decision on a depot's price-override proposal (design 7a). PENDING until HQ
/// approves (creates the winning pricing rule) or rejects it.
enum PriceOverrideStatus {
  PENDING
  APPROVED
  REJECTED
}

/// HD-17: who made a draft. AI = the AI web, through the closed draft endpoints.
enum DraftSource {
  STAFF
  AI
}

/// A depot manager's proposal to override a product's price at their depot (design 7a).
/// HQ approves (priority-wins) or rejects. On approval a PricingRule is created through
/// the existing pricing mechanism; this row only records the proposal + decision.
/// depotName/productName/currentPrice are denormalized snapshots for the HQ queue view
/// (mirrors CommissionScheme.ownerName): the depot-service does not own product names.
model PriceOverrideProposal {
  id           String              @id @default(uuid()) @db.Uuid
  depotId      String              @db.Uuid
  depot        Depot               @relation(fields: [depotId], references: [id], onDelete: Cascade)
  depotName    String
  productId    String              @db.Uuid
  productName  String
  /// Snapshot of the depot's current price at propose time (IDR).
  currentPrice Decimal             @db.Decimal(12, 2)
  adjustType   PricingAdjustType
  /// PERCENT = signed percent; FIXED = signed rupiah delta (same semantics as PricingRule).
  value        Decimal             @db.Decimal(12, 2)
  note         String?
  status       PriceOverrideStatus @default(PENDING)
  /// Account id of the proposing depot manager.
  proposedBy   String              @db.Uuid
  /// Account id of the HQ approver/rejecter. Null until decided.
  decidedBy    String?             @db.Uuid
  /// The reason HQ typed with the decision (a rejection's "why"); null when none was given.
  decisionReason String?
  /// HD-17: STAFF (a person proposed it) or AI (the AI web drafted it for a person; HQ still decides).
  source       DraftSource         @default(STAFF)
  /// The AI web's X-AI-Suggestion-Id; unique, so a retried call answers the same row.
  aiSuggestionId String?           @unique @db.Uuid
  /// Why the AI proposed it, shown beside the proposal in /hq/pricing.
  aiReason     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Newest-first queue reads by (status, createdAt).
  @@index([status, createdAt])
  @@map("price_override_proposals")
}

model PricingRule {
  id          String            @id @default(uuid()) @db.Uuid
  depotId     String            @db.Uuid
  depot       Depot             @relation(fields: [depotId], references: [id], onDelete: Cascade)
  productId   String?           @db.Uuid
  adjustType  PricingAdjustType
  value       Decimal           @db.Decimal(12, 2)
  daysOfWeek  Int[]
  startMinute Int?
  endMinute   Int?
  validFrom   DateTime?
  validUntil  DateTime?
  priority    Int               @default(0)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([depotId])
  @@map("pricing_rules")
}

/// Kind of depot operational incident (design 6b operator "Insiden depot" + 13b manager).
enum IncidentType {
  COURIER_FALL
  VEHICLE_BREAKDOWN
  CUSTOMER_CONFLICT
  POWER_OUTAGE
  GALLON_DAMAGE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

/// OPEN → IN_PROGRESS → RESOLVED lifecycle for a depot incident.
enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

/// Depot operational incidents inbox (design 6b/13b): one row per field/ops event
/// (courier fall, breakdown, complaint, outage, gallon damage) with a resolution trail.
model Incident {
  id             String           @id @default(uuid()) @db.Uuid
  depotId        String           @db.Uuid
  depot          Depot            @relation(fields: [depotId], references: [id], onDelete: Cascade)
  type           IncidentType
  severity       IncidentSeverity
  status         IncidentStatus   @default(OPEN)
  title          String
  description    String?
  /// Account id of the staff member who logged the incident.
  reportedBy     String           @db.Uuid
  /// Courier involved, if any (free text — courier need not be an account).
  courierName    String?
  /// Related order reference (e.g. "HM-...000476"), if any.
  orderRef       String?
  /// CA-2-58: the complainant's phone, when the operator took one.
  ///
  /// Optional, because an operator recording that a customer shouted at a courier is
  /// not always going to ask for a number, and refusing the record for want of one is
  /// how an incident stops existing. But without it head office has nothing to call
  /// back on, so it is also what decides whether this complaint can be mirrored.
  customerPhone  String?
  /// CA-2-58: the HQ support ticket this complaint was mirrored into.
  ///
  /// Null means it was not mirrored — no number was taken, or head office was
  /// unreachable when it was recorded. The screen shows that state rather than
  /// leaving a complaint that silently never travelled.
  hqTicketRef    String?
  /// Resolution note + who/when, set when the incident is marked RESOLVED.
  resolutionNote String?
  resolvedBy     String?          @db.Uuid
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Newest-first inbox reads by (depotId, status, createdAt).
  @@index([depotId, status, createdAt])
  @@map("incidents")
}

/// Purchase-order lifecycle (design 7a/9d): drafted → sent to supplier → goods received.
enum PoStatus {
  DRAFT
  SENT
  RECEIVED
}

/// A depot's supplier directory entry (design 11b): a vendor of raw stock
/// (galon/segel/air baku). categories is a free-text list, e.g. ["Galon 19L","Segel"].
model Supplier {
  id           String   @id @default(uuid()) @db.Uuid
  depotId      String   @db.Uuid
  depot        Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  name         String
  /// Short human code, unique within a depot.
  code         String
  contactPhone String?
  /// What they supply, e.g. ["Galon 19L","Segel","Air baku"].
  categories   String[]
  /// On-time delivery rate 0..1; null until enough POs land (denormalized metric).
  onTimeRate   Float?
  createdAt    DateTime @default(now())
  /// CA-2-53: the version a console form edits against. Two people on the supplier screen
  /// used to produce whichever of them saved last, with no way for the server to tell an
  /// edit from an overwrite.
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([depotId, code])
  @@index([depotId])
  @@map("suppliers")
}

/// A depot purchase order (design 7a/9d). `lines` is a JSON array of
/// { itemType, label, quantity, unitCostIdr }. Receiving a SENT PO posts a RECEIPT stock
/// movement per line into the depot's inventory. supplierName is a denormalized snapshot
/// so list/detail render without a supplier join.
/// CA-2-54: where a transfer is between leaving one depot and arriving at another.
enum StockTransferStatus {
  /// Dispatched: the sender's stock is already gone, the receiver's has not arrived.
  SENT
  /// The receiver confirmed the count. Both books are settled.
  RECEIVED
  /// Never arrived and was returned to the sender. Its stock is back where it started.
  CANCELLED
}

/// CA-2-54 — stock moving between two depots.
///
/// The only way stock could enter a depot was a purchase order to a supplier. A depot with
/// four spare gallons and one two streets away that had run out could do nothing about it:
/// the transfer that everyone does in practice, on a motorbike, had no record at all, so it
/// showed up as a shortfall in one book and an unexplained surplus in the other.
///
/// Two steps, not one, because a transfer is not instantaneous: the goods spend real time on
/// a bike. SENT deducts the sender immediately (they no longer have it) and RECEIVED credits
/// the receiver only when somebody there has counted it. What is in between is visible as
/// exactly that — in transit — instead of being invisible in both books at once.
model StockTransfer {
  id             String              @id @default(uuid()) @db.Uuid
  /// Human-facing reference, unique network-wide, e.g. "TRF-260909-0001".
  reference      String              @unique
  fromDepotId    String              @db.Uuid
  fromDepot      Depot               @relation("TransfersSent", fields: [fromDepotId], references: [id], onDelete: Restrict)
  toDepotId      String              @db.Uuid
  toDepot        Depot               @relation("TransfersReceived", fields: [toDepotId], references: [id], onDelete: Restrict)
  /// The catalog product moved. A transfer carries ONE product; two products are two
  /// transfers, because they are counted, loaded and received separately.
  productId      String              @db.Uuid
  /// Copied from the sending line so the record still reads after a product is renamed.
  label          String
  unit           String
  quantity       Int
  status         StockTransferStatus @default(SENT)
  note           String?
  sentBy         String              @db.Uuid
  sentAt         DateTime            @default(now())
  /// Who confirmed the count at the far end, and when. Null until it lands.
  receivedBy     String?             @db.Uuid
  receivedAt     DateTime?
  /// Why it came back, when it did.
  cancelReason   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([toDepotId, status, sentAt])
  @@index([fromDepotId, status, sentAt])
  @@map("stock_transfers")
}

model PurchaseOrder {
  id           String    @id @default(uuid()) @db.Uuid
  depotId      String    @db.Uuid
  depot        Depot     @relation(fields: [depotId], references: [id], onDelete: Restrict)
  /// Human PO reference, unique within a depot (e.g. "PO-A1B2C3D4").
  poNumber     String
  supplierId   String    @db.Uuid
  supplierName String
  status       PoStatus  @default(DRAFT)
  lines        Json      @default("[]")
  /// Whole IDR. subtotal = Σ(qty×unitCost); total = subtotal + shipping.
  subtotalIdr  Int
  shippingIdr  Int       @default(0)
  totalIdr     Int
  expectedAt   DateTime?
  receivedAt   DateTime?
  /// HD-17: STAFF or AI. An AI PO stays DRAFT until staff press Kirim (that IS the approval).
  source       DraftSource @default(STAFF)
  aiSuggestionId String?   @unique @db.Uuid
  aiReason     String?
  createdAt    DateTime  @default(now())

  @@unique([depotId, poNumber])
  @@index([depotId, status, createdAt])
  @@map("purchase_orders")
}

/// Kind of manager approval item (design 1c/2a-2c/10c/12a).
enum ApprovalType {
  OPNAME_VARIANCE
  DEPOSIT_REFUND
  COD_VARIANCE
  /// M15-11: an empty-gallon return that exceeds what the depot has outstanding.
  /// Queued for a manager instead of rejected — the empties are physically there.
  GALLON_VARIANCE
}

/// PENDING → APPROVED / REJECTED / HELD lifecycle for an approval item.
/// HELD parks an item for later without a final decision.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  HELD
}

/// Depot-manager approval queue (design 1c/2a-2c/10c/12a): one row per value decision a
/// manager must sign off — stock-count loss (opname), deposit refund, COD shortfall. Small
/// values auto-pass (APPROVED at create) under the depot's threshold; larger ones wait
/// PENDING for a Tolak/Tahan/Setujui decision. payload is a per-type JSON snapshot rendered
/// on the detail screen: {system,physical,variance} | {condition,deposit} | {expected,received}.
model Approval {
  id                String         @id @default(uuid()) @db.Uuid
  depotId           String         @db.Uuid
  depot             Depot          @relation(fields: [depotId], references: [id], onDelete: Restrict)
  type              ApprovalType
  status            ApprovalStatus @default(PENDING)
  title             String
  /// Account id of the operator/system that raised the item.
  submittedBy       String         @db.Uuid
  /// Human subject of the decision (product / customer / courier name).
  subjectRef        String?
  /// Signed rupiah at stake: loss (opname), refund (deposit), shortfall (COD).
  amountIdr         Int
  /// Per-type snapshot for the detail view.
  payload           Json           @default("{}")
  /// At/under |amount| this item auto-passed without review (snapshot of the threshold).
  autoPassThreshold Int
  decisionNote      String?
  decidedBy         String?        @db.Uuid
  decidedAt         DateTime?
  createdAt         DateTime       @default(now())

  // Newest-first queue reads by (depotId, status, createdAt).
  @@index([depotId, status, createdAt])
  @@map("approvals")
}

/// Courier shift kind on a roster cell (design: operator 6d "Jadwal shift kurir" + manager 7b).
enum ShiftKind {
  MORNING
  EVENING
  OFF
}

/// Courier shift roster (design 6d/7b): one row per (staff, day) of a depot's week. weekStart
/// is the ISO date string of that week's Monday (e.g. "2026-07-14"); day is 0=Mon..6=Sun. A
/// week's grid is the set of rows sharing (depotId, weekStart).
model ShiftAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  depotId   String    @db.Uuid
  depot     Depot     @relation(fields: [depotId], references: [id], onDelete: Cascade)
  staffId   String    @db.Uuid
  staffName String
  weekStart String
  day       Int
  shift     ShiftKind @default(OFF)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([depotId, weekStart, staffId, day])
  @@index([depotId, weekStart])
  @@map("shift_assignments")
}

/// Depot monthly targets (design 13a). One row per (depot, month=YYYY-MM). Actuals
/// (revenue/orders/SLA/new customers) are derived at read time from order/delivery
/// reports; this row stores only the goals a manager sets.
model DepotTarget {
  id                 String   @id @default(uuid()) @db.Uuid
  depotId            String   @db.Uuid
  depot              Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  /// ISO year-month, e.g. "2026-07".
  month              String
  revenueTargetIdr   Int      @default(0)
  ordersTarget       Int      @default(0)
  /// On-time SLA target as a whole percent (e.g. 96).
  slaTargetPct       Int      @default(0)
  newCustomersTarget Int      @default(0)
  /// HD-16: gallons SOLD in the month, the unit of the AI read API metric G-01 (gallon units on
  /// DELIVERED/COMPLETED orders by order date, counter sales and free promo gallons included). 0 = not set.
  gallonsTarget      Int      @default(0)
  updatedBy          String   @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([depotId, month])
  @@index([depotId])
  @@map("depot_targets")
}

/// HD-16 (owner decision D22): what a depot costs per month that no order, payroll or cash-book
/// line records: rent, electricity, depreciation, employer BPJS, ... One row per depot, month
/// and category, written by the spreadsheet import. Whole rupiah. HQ overhead is NOT allocated to depots.
model DepotFixedCost {
  id        String   @id @default(uuid()) @db.Uuid
  depotId   String   @db.Uuid
  /// Restrict: a hard delete of a depot must not silently wipe its cost history.
  depot     Depot    @relation(fields: [depotId], references: [id], onDelete: Restrict)
  /// WIB month key, e.g. "2026-11".
  month     String
  /// Lower-cased, trimmed, 1-40 characters: "sewa", "listrik", "bpjs pemberi kerja".
  category  String
  amountIdr Int
  note      String?
  updatedBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([depotId, month, category])
  @@index([month])
  @@map("depot_fixed_costs")
}

/// Kind of manual cashbook movement (design 14c). Derived movements (COD settlement in,
/// PO payment out) may be posted by other flows later; for now entries are manager-entered.
enum CashDirection {
  IN
  OUT
}

/// Depot cashbook / daily cash flow ledger (design 14c). Append-only rows of cash in
/// (COD settlement, walk-in sale) and out (PO payment, courier commission, expenses),
/// summed per day for an opening/closing balance.
model CashbookEntry {
  id         String        @id @default(uuid()) @db.Uuid
  depotId    String        @db.Uuid
  depot      Depot         @relation(fields: [depotId], references: [id], onDelete: Restrict)
  direction  CashDirection
  /// Short category, e.g. "COD", "PO", "KOMISI", "SEWA".
  category   String
  label      String
  amountIdr  Int
  occurredAt DateTime      @default(now())
  /// Optional link to the source (settlement id, PO number) when auto-posted.
  sourceRef  String?
  /// CA-2-22: the entry this one cancels, for a correction.
  ///
  /// The book is append-only on purpose — a ledger you can edit is a ledger nobody can
  /// audit — so a mistake is put right by POSTING THE OPPOSITE, not by rewriting history.
  /// Null on every ordinary entry. Unique, so one entry can be reversed exactly once.
  reversesId     String?   @db.Uuid
  /// Why it was reversed. Required by the service when `reversesId` is set: a correction
  /// with no reason is the same unexplained number in the other direction.
  reversalReason String?
  actorId    String        @db.Uuid
  createdAt  DateTime      @default(now())

  @@unique([reversesId])
  @@index([depotId, occurredAt])
  @@map("cashbook_entries")
}

enum CashierShiftStatus {
  OPEN
  CLOSED
}

/// One cashier's turn at the counter, from the float they started with to the cash they
/// counted at the end. Counter sales are refused while nobody has a shift open: without
/// one, the money in the drawer belongs to no named person and no shortfall has an owner.
model CashierShift {
  id           String             @id @default(uuid()) @db.Uuid
  depotId      String             @db.Uuid
  depot        Depot              @relation(fields: [depotId], references: [id], onDelete: Restrict)
  cashierId    String             @db.Uuid
  cashierName  String
  status       CashierShiftStatus @default(OPEN)
  /// Change money in the drawer before the first sale.
  openingFloat Int
  openedAt     DateTime           @default(now())

  closedAt     DateTime?
  /// What the cashier physically counted at close.
  countedCash  Int?
  /// openingFloat + PAID cash this depot took during the shift, computed server-side.
  expectedCash Int?
  /// countedCash − expectedCash. Negative = short.
  variance     Int?
  note         String?
  /// DEP-05: a shortfall HQ rejected becomes the cashier's liability (rupiah owed). NULL = none.
  liabilityIdr Int?
  /// When a manager settled or waived that liability (with who and why). NULL = still owed.
  liabilitySettledAt DateTime?
  liabilitySettledBy String?
  liabilityNote      String?

  // One OPEN shift per cashier per depot — enforced by a partial unique index in the
  // migration (Prisma cannot express `WHERE status = 'OPEN'` here).
  @@index([depotId, status])
  @@index([cashierId, status])
  @@map("cashier_shifts")
}

/// One depot's day, declared counted.
///
/// A depot's money arrives from two places that never met: counter cash posts itself into
/// the cashbook when a cashier shift closes, and courier COD lands in delivery-service when
/// a cashier accepts a deposit. Closing a day is the moment somebody says both were counted
/// and agrees what the numbers were — which is why the totals are SNAPSHOTTED here rather
/// than recomputed on read. A later correction must not silently rewrite what was signed off.
model DepotDailyClose {
  id              String    @id @default(uuid()) @db.Uuid
  depotId         String    @db.Uuid
  depot           Depot     @relation(fields: [depotId], references: [id], onDelete: Restrict)
  /// The business day, not an instant.
  businessDate    DateTime  @db.Date
  closedAt        DateTime
  closedBy        String    @db.Uuid
  cashInIdr       Int
  cashOutIdr      Int
  /// Counter takings inside cashIn, kept apart so the two money paths stay legible.
  konterIdr       Int
  /// COD the cashier accepted that day, read from delivery-service at close time.
  codDepositedIdr Int
  /// What the couriers were expected to hand over — the pair is what makes a gap visible.
  codExpectedIdr  Int
  note            String?
  /// Set when HQ reopens the day, cleared when it is closed again.
  reopenedAt      DateTime?
  reopenedBy      String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@unique([depotId, businessDate])
  @@map("depot_daily_closes")
}

/// "Tutup bulan": a depot's month, sealed once every one of its days is already closed.
/// Snapshotted like DepotDailyClose, and for the same reason — a later correction to one
/// day must show up as a difference against a month HQ already signed off, not quietly
/// rewrite the total underneath it.
model DepotMonthlyClose {
  id              String    @id @default(uuid()) @db.Uuid
  depotId         String    @db.Uuid
  depot           Depot     @relation(fields: [depotId], references: [id], onDelete: Restrict)
  /// The first day of the business month, e.g. 2026-09-01 for September — not an instant.
  businessMonth   DateTime  @db.Date
  closedAt        DateTime
  closedBy        String    @db.Uuid
  cashInIdr       Int
  cashOutIdr      Int
  konterIdr       Int
  codDepositedIdr Int
  codExpectedIdr  Int
  /// Always every business day up to the end of the month (or today, mid-month) — sealing
  /// refuses while any is still open.
  daysClosed      Int
  note            String?
  /// Set when HQ reopens the month, cleared when it is sealed again.
  reopenedAt      DateTime?
  reopenedBy      String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@unique([depotId, businessMonth])
  @@map("depot_monthly_closes")
}

/// Kind of customer order dispute (design 15c).
enum DisputeCategory {
  WRONG_ITEM
  NOT_RECEIVED
  OVERCHARGED
  QUALITY
  OTHER
}

/// OPEN → RESOLVED / REJECTED lifecycle of an order dispute.
enum DisputeStatus {
  OPEN
  RESOLVED
  REJECTED
}

/// How a resolved dispute was settled (design 15c).
enum DisputeResolution {
  REFUND
  RESEND
  REJECTED
}

/// Customer order disputes (design 15c): a claim against a delivered order (wrong item,
/// not received, overcharged, quality) and the manager's resolution.
model OrderDispute {
  id             String             @id @default(uuid()) @db.Uuid
  depotId        String             @db.Uuid
  depot          Depot              @relation(fields: [depotId], references: [id], onDelete: Restrict)
  orderRef       String
  /// UU PDP item 13: which account this dispute belongs to, so an erasure request can find
  /// it without matching on `customerName` — which would erase the disputes of everybody
  /// who shares the name. NULL = unknown: a counter dispute for a walk-in, or a row from
  /// before this column existed. Nothing READS it in the release that adds it; the erasure
  /// executor lands one release later, after the column is on the live database.
  customerId     String?            @db.Uuid
  customerName   String
  category       DisputeCategory
  description    String
  /// Amount in dispute (IDR), for the resolution quote.
  amountIdr      Int                @default(0)
  courierName    String?
  status         DisputeStatus      @default(OPEN)
  resolution     DisputeResolution?
  resolutionNote String?
  raisedBy       String             @db.Uuid
  resolvedBy     String?            @db.Uuid
  resolvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([depotId, status, createdAt])
  @@index([customerId])
  @@map("order_disputes")
}

/// Equipment health for a maintenance item (design 14a). DUE = overdue; SOON = within
/// the warning window; HEALTHY otherwise; NEW = recently replaced.
enum MaintenanceStatus {
  DUE
  SOON
  HEALTHY
  NEW
}

/// Depot equipment maintenance schedule (design 14a): RO filter, refill machine, genset,
/// UV lamp — each with a service interval and next-due date. `status` is derived from
/// nextDueAt at write time and recomputed on read.
model MaintenanceItem {
  id            String            @id @default(uuid()) @db.Uuid
  depotId       String            @db.Uuid
  depot         Depot             @relation(fields: [depotId], references: [id], onDelete: Cascade)
  name          String
  /// Short category label, e.g. "Filter RO", "Genset".
  category      String
  /// HD-15: due by days OR by water volume, whichever comes first. At least one is set (the
  /// DTO enforces it); a volume-only item has no nextDueAt.
  intervalDays  Int?
  /// HD-15: cubic metres of water through the depot's meter between services.
  intervalM3    Decimal?          @db.Decimal(12, 3)
  lastServicedAt DateTime?
  nextDueAt     DateTime?
  status        MaintenanceStatus @default(HEALTHY)
  note          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([depotId, nextDueAt])
  @@map("maintenance_items")
}

/// B2B wholesale price tier (design 15d): a quantity band mapping to a per-unit price for
/// bulk buyers (offices, restaurants). productId null = applies to the depot's default gallon.
model WholesaleTier {
  id        String   @id @default(uuid()) @db.Uuid
  depotId   String   @db.Uuid
  depot     Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  productId String?  @db.Uuid
  label     String
  /// Inclusive lower bound of the quantity band.
  minQty    Int
  /// Inclusive upper bound; null = open-ended (e.g. "50+").
  maxQty    Int?
  priceIdr  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([depotId])
  @@map("wholesale_tiers")
}

/// Recurring-order cadence (design 16b).
enum SubscriptionCadence {
  DAILY
  EVERY_3_DAYS
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

/// Customer recurring subscription (design 16b): a standing order (N gallons on a cadence)
/// that seeds an order in the queue on its run date. Auto-order generation is a scheduler
/// follow-up; this row is the definition + status the manager manages.
model Subscription {
  id           String              @id @default(uuid()) @db.Uuid
  depotId      String              @db.Uuid
  depot        Depot               @relation(fields: [depotId], references: [id], onDelete: Cascade)
  customerId   String?             @db.Uuid
  customerName String
  productLabel String
  /// D10: what the operator actually PICKED, as opposed to what they typed. The engine
  /// places orders for a product id; a label cannot be delivered.
  productId    String?             @db.Uuid
  /// D10: the order-service subscription this row now stands for — the engine that D1, D2,
  /// D4, D6, D8 and D9 repaired. Nullable forever: rows created before the link existed
  /// have none, and a row whose creation reached depot-service but not the engine must be
  /// visible as exactly that rather than silently look linked.
  orderSubscriptionId String?      @db.Uuid
  quantity     Int
  cadence      SubscriptionCadence
  status       SubscriptionStatus  @default(ACTIVE)
  nextRunAt    DateTime?
  note         String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([depotId, status])
  @@map("subscriptions")
}

/// Weekly team huddle (design 13c): one row per (depot, weekStart Monday). agenda and
/// actionItems are JSON arrays — agenda [{title,note}], actionItems [{text,assignee,done}].
model HuddleNote {
  id          String   @id @default(uuid()) @db.Uuid
  depotId     String   @db.Uuid
  depot       Depot    @relation(fields: [depotId], references: [id], onDelete: Cascade)
  /// ISO date of the week's Monday, e.g. "2026-07-14".
  weekStart   String
  heldAt      DateTime @default(now())
  /// "8 dari 9 hadir" style free text.
  attendance  String?
  agenda      Json     @default("[]")
  actionItems Json     @default("[]")
  recordedBy  String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([depotId, weekStart])
  @@index([depotId])
  @@map("huddle_notes")
}

/// Shift handover checklist (design 14d): a signed record passing a depot from one shift to
/// the next. items is a JSON array of { title, subtext, state: DONE|PARTIAL|PENDING }.
model ShiftHandover {
  id        String    @id @default(uuid()) @db.Uuid
  depotId   String    @db.Uuid
  depot     Depot     @relation(fields: [depotId], references: [id], onDelete: Cascade)
  /// e.g. "Pagi", "Sore".
  fromShift String
  toShift   String
  fromStaff String
  toStaff   String
  items     Json      @default("[]")
  note      String?
  /// Null until both operators sign the handover.
  signedAt  DateTime?
  recordedBy String   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([depotId, createdAt])
  @@map("shift_handovers")
}

/// Per-depot/global overridable service settings (key-value, GLOBAL falls back to DEPOT).
/// The supervision chain above the depot (F3): Depot -> Asisten SPV -> SPV -> Manager.
/// One row per SUBORDINATE — the primary key on `staffId` IS the "exactly one superior"
/// rule, so a cycle or a second boss cannot be recorded in the first place.
///
/// Deliberately NOT relations to Depot: these hold auth-service account ids, and
/// auth-service owns its own database.
model StaffSupervision {
  staffId    String   @id @db.Uuid
  superiorId String   @db.Uuid
  updatedBy  String?  @db.Uuid
  updatedAt  DateTime @default(now())

  @@index([superiorId])
  @@map("staff_supervision")
}

/// Who owns a franchise depot and what share of its revenue each owner takes.
///
/// Generational: changing the owners closes every open row (`effectiveTo = now`) and inserts
/// the new set in one transaction, so "who owned this depot when order X completed" stays
/// answerable and a late payout retry books the split that applied at the time. Open rows
/// (`effectiveTo IS NULL`) are the current owners: shares sum to 100, exactly one is primary
/// (enforced by the service, plus partial unique indexes in the migration). `Depot.ownerId`
/// mirrors the primary for one release so older readers keep working.
model DepotOwner {
  id            String    @id @default(uuid()) @db.Uuid
  depotId       String    @db.Uuid
  /// Auth account id (role FRANCHISE_OWNER); bare id, auth-service owns the account.
  ownerId       String    @db.Uuid
  sharePct      Decimal   @db.Decimal(5, 2)
  isPrimary     Boolean   @default(false)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdBy     String?   @db.Uuid

  depot         Depot     @relation(fields: [depotId], references: [id], onDelete: Cascade)

  @@index([depotId, effectiveTo])
  @@index([ownerId, effectiveTo])
  @@map("depot_owners")
}

/// Depots granted to somebody DIRECTLY, unioned with the hierarchy walk. Exists so a
/// depot with no assistant supervisor yet, or a temporary hand-over, can still be
/// covered without bending the chain.
model StaffDepotAssignment {
  staffId   String   @db.Uuid
  depotId   String   @db.Uuid
  updatedBy String?  @db.Uuid
  updatedAt DateTime @default(now())

  @@id([staffId, depotId])
  @@index([staffId])
  @@map("staff_depot_assignments")
}

model ServiceSetting {
  id        String   @id @default(uuid())
  scope     String   // 'GLOBAL' | 'DEPOT'
  /// Null for scope=GLOBAL. Foreign key here only — the other six services carry the
  /// same table with no Depot to point at, so theirs stays a bare id by necessity
  /// (audit DB-5). A depot that is deleted takes its own overrides with it.
  depotId   String?  @map("depot_id") @db.Uuid
  depot     Depot?   @relation(fields: [depotId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  // H-11: also two PARTIAL unique indexes, invisible to Prisma because it cannot express a
  // WHERE on an index: one key per depot, and one key globally. A plain @@unique here would
  // not constrain the GLOBAL rows — depotId is null on those and Postgres treats every NULL
  // as distinct. The repository upserts against them by catching the violation.
  //
  // They have existed since 20260724185000_service_settings; the audit's H-11 was true only of
  // hr-service, which gets them in 20260803160000_service_settings_unique.
  @@index([scope, depotId])
  @@map("service_settings")
}

/// HD-5: what a legal entity is to the business (Rencana Induk: three kinds of data owner).
enum LegalEntityKind {
  /// Holds the brand and sells the franchise (Indowater).
  FRANCHISOR
  /// Runs the company-owned HKP depots (Kelola).
  OPERATOR
  /// A franchise partner that owns WARALABA depots (mitra waralaba).
  FRANCHISEE
}

/// HD-5: a legal entity (a PT, or a person) that owns data in this network. Entered by head
/// office on /hq/legal-entities, nothing is seeded (owner decision 2026-11-22). Never deleted,
/// because dated history points at it: one entered by mistake is renamed or switched off.
model LegalEntity {
  id        String          @id @default(uuid()) @db.Uuid
  /// The registered name, e.g. "PT ...". Unique ignoring case and outer spaces (the service
  /// checks it: a mistyped duplicate would be a second company in every report).
  name      String
  kind      LegalEntityKind
  /// Off = not offered for new assignments. Its history and its grants stay as they are.
  active    Boolean         @default(true)
  createdBy String?         @db.Uuid
  updatedBy String?         @db.Uuid
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  depots    DepotLegalEntity[]
  aiGrants  LegalEntityAiGrant[]

  // Also a unique index on lower(name), invisible to Prisma (an expression): see the
  // 20261122120000_legal_entities migration.
  @@map("legal_entities")
}

/// HD-5: which legal entity a depot belongs to, as dated change points. On day D a depot
/// belongs to the row with the latest effectiveFrom <= D, so a period ends where the next one
/// starts and two periods can never overlap. A change on the same date replaces that row.
model DepotLegalEntity {
  id            String      @id @default(uuid()) @db.Uuid
  depotId       String      @db.Uuid
  legalEntityId String      @db.Uuid
  effectiveFrom DateTime    @db.Date
  /// Who wrote this row's current value, and when (a correction rewrites both).
  recordedBy    String?     @db.Uuid
  recordedAt    DateTime    @default(now())

  depot         Depot       @relation(fields: [depotId], references: [id], onDelete: Cascade)
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)

  @@unique([depotId, effectiveFrom])
  @@map("depot_legal_entities")
}

/// HD-5: the role x legal entity matrix. A row = that role may read this entity's data in the
/// AI web and the AI read API (HD-6); no row = it may not, so a new entity is readable by
/// nobody but SUPER_ADMIN until somebody grants it. Owner decision 2026-11-22: it only LIMITS.
/// A grant never widens anybody's reach: HD-6 applies the caller's own depot scope or
/// ownership first and this matrix on top, so a franchise owner granted "PT Mitra A" still
/// sees only their own depots. Nothing in hydromart-digital reads this table.
model LegalEntityAiGrant {
  legalEntityId String      @db.Uuid
  /// A built-in role or a custom role key (C_...). Never SUPER_ADMIN, which reads everything.
  roleKey       String
  grantedBy     String?     @db.Uuid
  grantedAt     DateTime    @default(now())

  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@id([legalEntityId, roleKey])
  @@map("legal_entity_ai_grants")
}

/// HD-6 H5 (decision 32): the stage history of franchise applications, one row per stage an
/// application entered (PENDING at submission, then each stage change and the decision). No
/// foreign key and no personal data, on purpose: a rejected application is deleted after its
/// retention window (CA-3-53), and the count of how many came in and how many were turned down
/// must outlive it. History starts the day this ships; nothing is backfilled.
model FranchiseApplicationStageEvent {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @db.Uuid
  stage         FranchiseAppStage
  at            DateTime          @default(now())

  @@index([stage, applicationId])
  @@map("franchise_application_stage_events")
}

/// HD-7: events owed to admin-service's webhook fan-out, the same shape as delivery-service's
/// AAS-11 outbox. Written in the SAME transaction as the row the event reports (a franchise
/// application), so a crash cannot keep one without the other; sent once inline, re-sent by the
/// scheduler sweep until admin-service takes it. Unique on the idempotency key admin-service and
/// the receiver dedupe on. Payloads carry no personal data.
model WebhookEventOutbox {
  id            String   @id @default(uuid()) @db.Uuid
  event         String
  eventId       String   @unique
  payload       Json
  occurredAt    DateTime
  /// PENDING | DONE (a plain string: no enum migration to add a state later). Never given up,
  /// so no DEAD state here, unlike delivery-service's outbox.
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@map("webhook_event_outbox")
}

/// HD-15B: a checklist head office writes once and every supervisor visit starts from (decision
/// D18). Network-wide, no depot column. A visit COPIES the item text when it starts (PR-4), so
/// editing or deactivating a template never changes a visit already made.
model VisitTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  name      String
  active    Boolean             @default(true)
  createdBy String?             @db.Uuid
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  items     VisitTemplateItem[]

  @@map("visit_templates")
}

/// One line of a template's checklist, in `position` order. `sopId` is hr-service's Sop.id, a bare
/// id on purpose (no cross-service FK): an id hr does not know simply resolves to "no SOP in
/// force" when it is looked up, so this table never depends on hr being up.
model VisitTemplateItem {
  id         String        @id @default(uuid()) @db.Uuid
  templateId String        @db.Uuid
  position   Int
  text       String
  sopId      String?       @db.Uuid
  template   VisitTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, position])
  @@map("visit_template_items")
}

enum VisitStatus {
  IN_PROGRESS
  COMPLETED
}

enum VisitItemResult {
  PENDING
  PASS
  FINDING
}

enum FollowUpStatus {
  OPEN
  DONE
}

/// HD-15B PR-4: one supervisor visit to one depot. Opened by a GPS check-in inside the depot's
/// area; the checklist is COPIED from the template at that moment (text and the SOP version in
/// force, by value), so nothing a head office later edits changes a visit already made.
/// Two partial indexes are hand-written in the migration (Prisma cannot express them): at most one
/// IN_PROGRESS visit per (visitorId, depotId), and the open-follow-up lookup on visit_items.
model Visit {
  id               String      @id @default(uuid()) @db.Uuid
  depotId          String      @db.Uuid
  depot            Depot       @relation(fields: [depotId], references: [id], onDelete: Restrict)
  /// The template it started from. A bare id: the template may be edited or retired later.
  templateId       String?     @db.Uuid
  templateName     String
  /// Auth account of the supervisor.
  visitorId        String      @db.Uuid
  status           VisitStatus @default(IN_PROGRESS)
  checkInAt        DateTime    @default(now())
  checkInLat       Float
  checkInLng       Float
  checkInAccuracyM Float?
  checkInDistanceM Int?
  /// The phone's fix was "Perkiraan" (about 2 km off) yet landed inside the fence.
  approximateFix   Boolean     @default(false)
  /// false when the depot has no centre or its radius is 0: the visit was recorded, not fenced.
  fenceChecked     Boolean
  completedAt      DateTime?
  /// Photos accepted for this visit so far; capped at 3 per checklist line so a stuck client cannot fill the bucket.
  photoUploads     Int         @default(0)
  items            VisitItem[]

  @@index([depotId, checkInAt])
  @@index([visitorId, status])
  @@map("visits")
}

/// One checklist line of a visit. text and the SOP columns are snapshots taken at check-in; there is
/// deliberately NO reference to visit_template_items (a template edit replaces those rows).
/// A finding is the line itself: result FINDING with a note, a photo and a follow-up (one per item).
model VisitItem {
  id                  String          @id @default(uuid()) @db.Uuid
  visitId             String          @db.Uuid
  visit               Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  /// Denormalised so findings and overdue follow-ups are queried per depot without a join.
  depotId             String          @db.Uuid
  position            Int
  text                String
  sopId               String?         @db.Uuid
  sopVersionId        String?         @db.Uuid
  sopVersionNo        Int?
  sopTitle            String?
  result              VisitItemResult @default(PENDING)
  findingNote         String?
  photoKey            String?
  /// WIB day (a date, no clock).
  followUpDueOn       DateTime?       @db.Date
  followUpStatus      FollowUpStatus?
  followUpDoneAt      DateTime?
  followUpDoneBy      String?         @db.Uuid
  followUpNote        String?
  /// PR-6 stamps this when an overdue reminder goes out.
  lastOverdueNoticeAt DateTime?

  @@index([visitId])
  @@map("visit_items")
}

/// HD-21: what the AI web's CRM proposes as a new depot, one row per prospect. A draft is never a
/// depot: HQ (franchiseApplications holders) activates it in a later PR. Dates are WIB calendar
/// days as YYYY-MM-DD text. `requestHash` is the replay key: the same prospect and body answers
/// the row, another body while DRAFT is a 409.
model DepotDraft {
  id                     String           @id @default(uuid()) @db.Uuid
  prospectId             String           @unique @db.Uuid
  legacyApplicationId    String?          @db.Uuid
  proposedName           String
  city                   String
  province               String
  /// Personal data of the calon mitra: cleared (NULL) the moment HQ decides (UU PDP).
  ownerFullName          String?
  ownerPhoneE164         String?
  prospectusHandedOn     String           @db.VarChar(10)
  agreementSignedOn      String           @db.VarChar(10)
  prospectusSha256       String           @db.VarChar(64)
  prospectusVersionLabel String
  prospectusReceipt      String
  checklist              Json
  /// The replay key; NULL once HQ has decided (the hash covered the owner's name and phone).
  requestHash            String?          @db.VarChar(64)
  suggestionId           String           @db.Uuid
  status                 DepotDraftStatus @default(DRAFT)
  decisionNote           String?
  decidedBy              String?          @db.Uuid
  decidedAt              DateTime?
  depotId                String?          @unique @db.Uuid
  depot                  Depot?           @relation(fields: [depotId], references: [id], onDelete: Restrict)
  createdBy              String           @db.Uuid
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@map("depot_drafts")
}

enum DepotDraftStatus {
  DRAFT
  ACTIVATED
  REJECTED
}

// --- HD-14: quality hold, lab tests, permits --------------------------------------------------

enum QualityHoldStatus {
  ACTIVE
  ENDED
}

enum QualityHoldReason {
  LAB_FAIL
  PERMIT
  COMPLAINT
  OTHER
}

enum LabTestKind {
  FISIK_MIKRO
  KIMIA
  ECOLI
  LENGKAP
}

enum LabTestResult {
  PASS
  FAIL
}

/// A depot that stops selling. One ACTIVE row per depot (partial unique index in the migration,
/// raw SQL like the open-shift index). `note` is staff text: it never leaves hydromart (not in the
/// webhook event, not in anything a customer sees).
model DepotQualityHold {
  id          String            @id @default(uuid()) @db.Uuid
  depotId     String            @db.Uuid
  depot       Depot             @relation(fields: [depotId], references: [id], onDelete: Restrict)
  status      QualityHoldStatus @default(ACTIVE)
  reasonCode  QualityHoldReason
  note        String?
  startedBy   String            @db.Uuid
  startedAt   DateTime          @default(now())
  endedBy     String?           @db.Uuid
  endedAt     DateTime?
  /// The PASS lab test the end rests on.
  endRetestId String?           @db.Uuid
  endRetest   DepotLabTest?     @relation(fields: [endRetestId], references: [id], onDelete: Restrict)

  @@index([depotId, startedAt])
  @@map("depot_quality_holds")
}

/// One lab report. `takenOn` / `resultOn` are WIB day keys (YYYY-MM-DD text).
model DepotLabTest {
  id         String             @id @default(uuid()) @db.Uuid
  depotId    String             @db.Uuid
  depot      Depot              @relation(fields: [depotId], references: [id], onDelete: Restrict)
  kind       LabTestKind
  takenOn    String             @db.VarChar(10)
  resultOn   String             @db.VarChar(10)
  result     LabTestResult
  labName    String
  reportNo   String
  recordedBy String             @db.Uuid
  createdAt  DateTime           @default(now())
  holdsEnded DepotQualityHold[]

  @@index([depotId, takenOn])
  @@map("depot_lab_tests")
}

/// One permit (SLHS and the like). `validUntil` is a WIB day key.
model DepotPermit {
  id         String   @id @default(uuid()) @db.Uuid
  depotId    String   @db.Uuid
  depot      Depot    @relation(fields: [depotId], references: [id], onDelete: Restrict)
  kind       String
  number     String
  validUntil String   @db.VarChar(10)
  recordedBy String   @db.Uuid
  createdAt  DateTime @default(now())

  @@index([depotId, validUntil])
  @@map("depot_permits")
}
