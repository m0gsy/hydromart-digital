NODE_ENV=development
DEPOT_SERVICE_PORT=3007
DEPOT_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_depot?schema=public
# JWT_ACCESS_SECRET & INTERNAL_SERVICE_KEY are shared across every service.
# Set them ONCE in the repo-root .env (each service loads it via the ../../.env
# fallback in ConfigModule). Do NOT redefine them here — divergent copies are
# exactly what broke cross-service auth before (see hydromart-prod-boot-findings).
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
# Low-stock alerting (FR-074), optional. Both blank = disabled (no alert emitted).
CRM_SERVICE_URL=http://localhost:3012
# admin-service: the HQ complaint mirror and (HD-7) webhook events such as a submitted franchise
# application. Blank = events stay owed in the outbox and the sweep reports failing rounds.
ADMIN_SERVICE_URL=http://localhost:3017
HR_SERVICE_URL=http://localhost:3018
# Supervisor visit finding photos: a PRIVATE bucket and key of their own (optional; unset = the photo
# upload answers 503). Only read when STORAGE_DRIVER=s3.
# VISIT_STORAGE_S3_BUCKET=
# VISIT_STORAGE_S3_ACCESS_KEY_ID=
# VISIT_STORAGE_S3_SECRET_ACCESS_KEY=
# VISIT_CHECKIN_RADIUS_M=200
# Visit finding / overdue follow-up notices (needs CRM_SERVICE_URL); off until the Ops visit screens ship.
# VISIT_NOTIFY_ENABLED=false
DEPOT_ALERT_PHONE=
# HD-22: https URL of the AI web partner form; blank = /waralaba keeps its in-app form.
FRANCHISE_LEAD_FORM_URL=
# Per-gallon deposit (IDR) refunded on a courier-recorded return (design 2e). Server
# computes deposit × qty; the courier never enters an amount.
GALLON_DEPOSIT_IDR=20000
