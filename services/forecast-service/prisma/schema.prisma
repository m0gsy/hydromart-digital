// Hydromart forecast-service data model (Release 3 Predictive Analytics slice).
// Denormalized read model fed by order-service on COMPLETED: per-depot per-product
// per-day unit demand (quantity summed, not just order count) drives the heuristic
// demand forecast. ProductRef is a local snapshot so queries never need a
// cross-service call at read time. IngestedOrder guards ingestion idempotency.

generator client {
  provider = "prisma-client-js"
  // Service-local output so it never clobbers other services' @prisma/client.
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("FORECAST_DATABASE_URL")
}

model ProductDailyDemand {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  depotId    String?  @db.Uuid
  day        DateTime @db.Date
  quantity   Int      @default(0)
  orderCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, depotId, day])
  @@index([depotId, day])
  @@index([productId, depotId])
  @@map("product_daily_demand")
}

model DepotDailyRevenue {
  id         String   @id @default(uuid()) @db.Uuid
  depotId    String?  @db.Uuid
  day        DateTime @db.Date
  revenue    Int      @default(0)
  orderCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([depotId, day])
  @@index([day])
  @@map("depot_daily_revenue")
}

model CustomerActivity {
  customerId  String   @id @db.Uuid
  depotId     String?  @db.Uuid
  lastOrderAt DateTime
  orderCount  Int      @default(0)
  totalSpent  Int      @default(0) // lifetime rupiah (the M in RFM-lite churn)
  updatedAt   DateTime @updatedAt

  @@index([depotId, lastOrderAt])
  @@map("customer_activity")
}

model ProductRef {
  productId String   @id @db.Uuid
  name      String
  sku       String
  unit      String
  updatedAt DateTime @updatedAt

  @@map("product_ref")
}

model IngestedOrder {
  orderId    String   @id @db.Uuid
  ingestedAt DateTime @default(now())

  @@map("ingested_order")
}

/// PR-J: which demand and churn model this depot's forecasts run through. Same shape as
/// the settings slice seven other services already own, so the console edits it the way it
/// edits every other business tunable — and switching a model back is a click, not a deploy.
model ServiceSetting {
  id        String   @id @default(uuid())
  scope     String
  depotId   String?  @map("depot_id")
  key       String
  value     String
  updatedBy String   @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Two PARTIAL unique indexes live in the migration and are invisible to Prisma (it
  // cannot express a WHERE on an index): one key per depot, one key globally. A plain
  // @@unique here would not constrain the GLOBAL rows, because depot_id is null on those
  // and Postgres treats every NULL as distinct. The repository upserts against them by
  // catching the violation.
  @@index([scope, depotId])
  @@map("service_settings")
}
