# ------------------------------------------------------------------
# Hydromart — environment variables (copy to .env and fill in values)
# NEVER commit a real .env file. Secrets belong in a secret manager.
# ------------------------------------------------------------------

# ---- Runtime ----
NODE_ENV=development

# ---- Customer Service ----
CUSTOMER_SERVICE_PORT=3002
CUSTOMER_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_customer?schema=public
MAX_ADDRESSES_PER_CUSTOMER=20
# Birthday promo (FR-091). Blank LOYALTY_SERVICE_URL disables the sweep; reuses loyalty-service.
LOYALTY_SERVICE_URL=http://localhost:3009
# J-1: the depot customer directory's order count, last order and segment. Blank = those
# three columns are empty and the CRM dashboard reads all zeros, silently — the adapter
# fails soft, so nothing logs when this is missing.
ORDER_SERVICE_URL=http://localhost:3004
BIRTHDAY_REWARD_POINTS=250

# ---- Product Service ----
PRODUCT_SERVICE_PORT=3003
PRODUCT_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_product?schema=public
# Depot stock lines copy a product's name when they are opened, so a rename or a
# deactivation is pushed here to keep them in step. Blank = push off (fail-open): depot
# labels then go stale until the line is recreated.
DEPOT_SERVICE_URL=http://localhost:3007

# ---- Order Service ----
ORDER_SERVICE_PORT=3004
ORDER_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_order?schema=public
# Base URL the order-service calls to resolve authoritative product prices at checkout.
PRODUCT_SERVICE_URL=http://localhost:3003
# depot-service base URL — checkout routes each order to the nearest covering depot (FR-098).
DEPOT_SERVICE_URL=http://localhost:3007
# loyalty-service base URL — points are awarded here when an order completes (BR-013).
LOYALTY_SERVICE_URL=http://localhost:3009
# customer-service base URL — resolves the checking-out customer's reseller pricing.
CUSTOMER_SERVICE_URL=http://localhost:3002
# promo-service base URL — vouchers are validated/redeemed here at checkout (FR-030/090).
PROMO_SERVICE_URL=http://localhost:3010
# referral-service base URL — referrals are qualified here when an order completes (FR-092).
REFERRAL_SERVICE_URL=http://localhost:3011
# crm-service base URL — WhatsApp notifications fire here on order lifecycle changes (FR-093/094).
CRM_SERVICE_URL=http://localhost:3012
# Shared secret for internal service-auth: authenticates notifications to crm AND the
# payment→order confirm callback. Must match INTERNAL_SERVICE_KEY everywhere. Blank = fail-closed.
INTERNAL_SERVICE_KEY=change-me-internal-service-key
# Flat delivery fee applied at checkout, in IDR (per-depot/zone pricing lands in M5).
ORDER_DELIVERY_FEE=5000

# ---- Payment Service ----
PAYMENT_SERVICE_PORT=3005
PAYMENT_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_payment?schema=public
# Payment gateway for online methods (QRIS/E-Wallet/VA). Blank in dev = online charges fail closed.
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY=
# HMAC-SHA256 secret the gateway signs webhook callbacks with.
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret-min-16-chars
# order-service base URL + shared secret: a settled payment (webhook/staff confirm) calls
# order-service to confirm the order (fires ORDER_CONFIRMED). Both blank = callback disabled.
ORDER_SERVICE_URL=http://localhost:3004
INTERNAL_SERVICE_KEY=change-me-internal-service-key

# ---- Delivery Service ----
DELIVERY_SERVICE_PORT=3006
DELIVERY_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_delivery?schema=public
# order-service base URL — delivery status changes are synced to the order (BR-012).
ORDER_SERVICE_URL=http://localhost:3004
# Max concurrent active deliveries per driver (BR: one driver = one active order; raise for multi-drop).
MAX_ACTIVE_DELIVERIES_PER_DRIVER=1
# Courier shift (design 3a/3b). delivery-service also needs DEPOT_SERVICE_URL (defined
# above) to read the depot coordinates a check-in is verified against, and
# PAYMENT_SERVICE_URL (defined below) to read the PAID-cash total at COD settlement (2d).
# How close to the depot a courier must stand to check in, in metres.
SHIFT_CHECKIN_RADIUS_M=200
# Shift window length, frozen onto the shift at check-in.
SHIFT_LENGTH_HOURS=8
# Paid break allowance per shift. Going over is recorded as an overage, not blocked.
# B6: 60 is what the depot settings UI advertises (setting-defs.ts) and what courier
# design 3b specifies. It used to be 30 here and 60 there.
SHIFT_BREAK_QUOTA_MINUTES=60
# No-show gate (5a): min contact attempts + min wait (seconds from first attempt)
# before a delivery may be failed as a no-show.
NO_SHOW_MIN_CONTACT_ATTEMPTS=2
NO_SHOW_MIN_WAIT_SECONDS=300
# Delivery SLA target in minutes (assigned→delivered); deliveries over this count as breached (FR-099).
DELIVERY_SLA_MINUTES=120
# UU PDP retention window for proof-of-delivery data. It no longer drives the purge —
# admin-service owns the retention policy for every dataset and sends delivery-service the
# cutoff, because one legal rule with two owners can silently disagree. What is left reading
# this is scripts/verify-object-storage.mjs: it is the bucket lifecycle the ops check expects
# (on hydromart-pod: expire pod/* after 365d).
POD_RETENTION_DAYS=365
# HIGH field incidents (design 4b) push to the ops feed via crm-service. Blank = disabled
# (fail-open). The WhatsApp number comes from DEPOT_ALERT_PHONE below: compose passes it in
# as OPS_ALERT_PHONE, which is the name the variable carries INSIDE the container only.
# Setting OPS_ALERT_PHONE here reached nobody, so it is not a key.
CRM_SERVICE_URL=http://localhost:3012

# ---- Dashboard Service (BFF, no database) ----
DASHBOARD_SERVICE_PORT=3008
# Upstream report sources the executive dashboard aggregates (FR-100).
ORDER_SERVICE_URL=http://localhost:3004
DELIVERY_SERVICE_URL=http://localhost:3006
# Also needs DEPOT_SERVICE_URL (defined above) for the franchise dashboard (M-R3.2).

# ---- API Gateway (single ingress, no database) ----
# Public entry point; routes /{service}/... to each upstream (strips the segment).
GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://localhost:3001
CUSTOMER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3005
DEPOT_SERVICE_URL=http://localhost:3007
DASHBOARD_SERVICE_URL=http://localhost:3008
LOYALTY_SERVICE_URL=http://localhost:3009
PROMO_SERVICE_URL=http://localhost:3010
REFERRAL_SERVICE_URL=http://localhost:3011
CRM_SERVICE_URL=http://localhost:3012
RECOMMENDATION_SERVICE_URL=http://localhost:3013
FORECAST_SERVICE_URL=http://localhost:3014
PAYOUT_SERVICE_URL=http://localhost:3016
# (ORDER_SERVICE_URL and DELIVERY_SERVICE_URL are defined above.)

# ---- Depot Service ----
DEPOT_SERVICE_PORT=3007
DEPOT_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_depot?schema=public
# Low-stock alerting (FR-074), optional. Both blank = disabled (no alert emitted).
# CRM_SERVICE_URL reuses crm-service; DEPOT_ALERT_PHONE is the ops/warehouse WhatsApp number.
CRM_SERVICE_URL=http://localhost:3012
DEPOT_ALERT_PHONE=
# ^ also feeds order-service's water-meter variance alert (ORDER_ALERT_PHONE) and
#   delivery-service's incident alert (OPS_ALERT_PHONE). One ops number, three
#   consumers — blank leaves all three silent (fail-open, never blocks a write).
# Product catalog, read when a PRODUK stock line is opened: it refuses an id the catalog
# does not have and names the line from the catalog, so the two can never drift. Blank =
# validation off (fail-open), and the line keeps whatever label was typed.
PRODUCT_SERVICE_URL=http://localhost:3003
# Per-gallon deposit (IDR) refunded on a courier-recorded return (design 2e).
GALLON_DEPOSIT_IDR=20000

# ---- Loyalty Service ----
LOYALTY_SERVICE_PORT=3009
LOYALTY_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_loyalty?schema=public
# Loyalty policy (BR-013/BR-014): 1 point per this many rupiah of subtotal; expiry in months.
LOYALTY_EARN_RATE_RUPIAH=1000
LOYALTY_POINT_EXPIRY_MONTHS=12
# PAR-01: the scheduled expiry sweep is INERT until this is 1. It ships off so the release
# that finally connects BR-014 to the scheduler cannot expire a backlog of points nobody
# decided to expire. Flip it here or, per environment, via the global setting.
LOYALTY_POINT_EXPIRY_SWEEP_ENABLED=0

# ---- Promo Service (vouchers/coupons) ----
PROMO_SERVICE_PORT=3010
PROMO_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_promo?schema=public
# Authoritative affected-order totals for promotion analytics.
ORDER_SERVICE_URL=http://localhost:3004

# ---- Referral Service (FR-092) ----
REFERRAL_SERVICE_PORT=3011
REFERRAL_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_referral?schema=public
# loyalty-service base URL — referral rewards are granted as loyalty points here.
LOYALTY_SERVICE_URL=http://localhost:3009
# Referral reward policy (company policy, not in PRD): points granted on qualification.
REFERRAL_REFERRER_POINTS=500
REFERRAL_REFEREE_POINTS=250

# ---- CRM Service (broadcast campaigns, FR-088/FR-094) ----
CRM_SERVICE_PORT=3012
CRM_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_crm?schema=public
# WhatsApp Business Cloud API for broadcasts. Blank in dev = console/log fallback (no send).
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# customer-service base URL for FR-087 attribute segmentation. Blank disables segment targeting.
CUSTOMER_SERVICE_URL=http://localhost:3002
# Shared secret authenticating system-to-system notification calls (POST /notifications/internal).
# Must match INTERNAL_SERVICE_KEY in every service that sends internal notifications. Blank = fail-closed.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_SERVICE_KEY=change-me-internal-service-key

# ---- Recommendation Service ----
RECOMMENDATION_SERVICE_PORT=3013
RECOMMENDATION_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_recommendation?schema=public
# order-service base URL; used later for the completed-orders rebuild feed (fail-open when blank).
ORDER_SERVICE_URL=http://localhost:3004

# ---- Forecast Service (demand forecasting / predictive analytics read model) ----
# FORECAST_SERVICE_URL for the gateway is defined in the API Gateway block above.
FORECAST_SERVICE_PORT=3014
FORECAST_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_forecast?schema=public

# ---- Payout Service ----
PAYOUT_SERVICE_PORT=3016
PAYOUT_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_payout?schema=public

# ---- Auth Service ----
AUTH_SERVICE_PORT=3001

# crm-service base URL + shared internal key for the registration welcome (fail-open; both blank = disabled).
CRM_SERVICE_URL=http://localhost:3012
INTERNAL_SERVICE_KEY=change-me-internal-service-key

# hr-service, for the employee record behind an invited staff account. Fails CLOSED: blank
# makes "Undang staf" error rather than create a login nobody in HR can pay or roster.
HR_SERVICE_URL=http://localhost:3018

# PostgreSQL connection string used by Prisma (auth-service).
# Local docker-compose default shown below.
AUTH_DATABASE_URL=postgresql://hydromart:hydromart@localhost:5432/hydromart_auth?schema=public

# JWT signing. Use long, random, high-entropy values in every environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# One-Time Password policy (BR-002: OTP valid max 5 minutes).
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# OTP delivery channel: console | sms | zenziva
# 'console' logs the OTP (development only) and auth-service REFUSES to boot on it under
# NODE_ENV=production. Production runs `zenziva`; its two credentials are below and they
# are what the deploy's OTP probe reads.
OTP_DELIVERY_CHANNEL=console

# SMS provider (used when OTP_DELIVERY_CHANNEL=sms)
SMS_API_BASE_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=HYDROMART

# Zenziva masking SMS (used when OTP_DELIVERY_CHANNEL=zenziva) — the PRODUCTION channel.
# Declared here because scripts/lib/deploy-common.sh compares the box's .env against THIS
# file: a variable absent here is a variable the per-deploy env-contract gate is structurally
# blind to, and these two were absent while production depended on them.
#
# ZENZIVA_BASE_URL is deliberately NOT listed. It carries a Joi default that IS the
# production value (env.validation.ts:91, `https://console.zenziva.net`), so a box that never
# sets it is a box that is working — and the contract gate flagged it on the very first
# deploy after it was added here. A line in this file that can never indicate a fault is
# noise in a gate whose entire value is that somebody reads it; this repo has already had one
# deploy warning that was 84% noise and hid three real findings inside itself.
ZENZIVA_USERKEY=
ZENZIVA_PASSKEY=

# ---- Alerting + offsite backups (read by scripts, not only by services) ----
# The single destination every alarm in this system points at: the 5xx alerter
# (packages/platform/.../error-alerter.ts), Alertmanager, the watchdog, the nightly backup
# and the weekly restore drill all POST here. Blank = every one of them is raised, rendered
# and dropped, which looks exactly like a quiet week — this box spent its first months in
# that state. It was also ABSENT from this file until 2026-08-29, so the deploy's
# env-contract gate (deploy-common.sh missing_env_keys) was structurally unable to report
# it: a key that is not in the contract cannot be missing from it.
# One incoming webhook works for both Slack and Discord.
ALERT_WEBHOOK_URL=

# Offsite copy of the database dumps. backup-db.sh keeps 14 nightly dumps and
# backup-offsite.sh pushes them away from the box; blank means EVERY copy of the database
# lives on the same disk as the database, so one full or failed disk takes the data and its
# own backups together.
# These three reach no compose file — only scripts read them — so compose_ignores_env()
# filters them out of the env-contract warning and cannot report them however they are
# listed here. deploy.sh's `ops secrets probe` is what actually reads them; they are
# documented here because this file is the contract an operator fills in.
#   BACKUP_OFFSITE_DEST  s3://bucket[/prefix] or a directory on another volume
BACKUP_OFFSITE_DEST=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Public certificate the nightly .env backup encrypts to. The PRIVATE half must never be on
# this machine — that is what makes storing the backup safe. Blank = the configuration for
# this box exists nowhere else, and scripts/backup-env.sh says so every night.
#   scripts/backup-env.sh --help  for the one-time keypair command
BACKUP_ENV_CERT=

# Backend error reporting. Blank = off, and off is the current state everywhere.
# packages/platform/src/nest/sentry.ts is entirely DSN-gated: blank means init() is never
# called and nothing is ever sent. Set it here and every service picks it up on the next
# deploy — it is a RUNTIME variable, unlike SENTRY_DSN_WEB below, which is a build arg.
SENTRY_DSN=

# One phone number the whole courier fleet can call or WhatsApp from the in-app help
# screen. BUILD ARG, not runtime: `next build` inlines NEXT_PUBLIC_* into the bundle, so
# changing this needs a rebuild, and a value set only in a running container does nothing.
# Blank = both buttons are hidden, which is the correct look for a fleet with no single line.
# Not assigned here, for the same reason as the rate-limit block above: blank is a correct,
# working state (both buttons hidden), so a warning about it every deploy would be noise.
#   COURIER_HOTLINE          default blank — see .env.production.example

# ---- Security ----
# Comma-separated list of allowed CORS origins for the customer web app.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Global API rate limit, per CLIENT per window — not per deployment (that was fixed with
# `trust proxy`; before it, 100 only ever looked sufficient because everyone shared a bucket).
#
# 600, not the 100 this file advertised for months. Production has run 600 since the fan-out
# regression: one HQ dashboard page fires ~201 requests on open (audit F-1), so 100 could not
# survive a single page load even with correct per-client keying. The Joi default in
# gateway-service/src/config/env.validation.ts:44 has said 600 all along; this file was the
# half that drifted, and neither number reached the container until the compose passthrough
# was added, so nobody found out.
#
# It is a CEILING, not a target. When the HQ fan-out drops, bring it down — with a measured
# request budget, not a guess.
# NOT assigned here on purpose — see the note at the end of this block.
#   RATE_LIMIT_TTL_SECONDS   default 60
#   RATE_LIMIT_MAX           default 600
# The OTP tier, and it guards a BILL rather than a CPU. Every request past it that reaches
# auth-service sends a real SMS through Zenziva, invoiced per message. auth-service caps
# RESENDS per customer, but nothing capped a caller walking a different phone number on
# every request — at RATE_LIMIT_MAX that is hundreds of paid messages a minute from one
# host. A human registering needs three calls, so twenty a minute is roughly seven honest
# attempts.
#   RATE_LIMIT_OTP_MAX       default 20
# The BURST allowance: the token bucket's CAPACITY — the most one caller may spend at once.
# RATE_LIMIT_MAX above is the sustained rate (how fast the bucket refills). Those are the two
# numbers a fixed window could not express at the same time, and the window's boundary let a
# caller send twice the limit in two seconds while staying inside the rules.
# 300 with a 600/minute refill: burst 300, then ten a second forever.
#   RATE_LIMIT_BURST_MAX     default 300
#
# Why none of the four is assigned in THIS file: scripts/lib/deploy-common.sh:329 compares the
# box's .env against .env.example key by key and warns about anything the box does not set. All
# four defaults in docker-compose.prod.yml ARE the values production runs, so a box that never
# sets them is a box that is working — and a line here that can never indicate a fault is noise
# in a gate whose entire value is that somebody reads it. The full reference, with defaults and
# what changes when each is blank, is in .env.production.example.
#
# Set any of them on the box to override; the compose passthrough makes them reachable.

# ─── Object storage (uploads: PoD photo/signature + product images) ───
# BiznetGio NEO Object Storage (S3-compatible). Keys are PER-BUCKET, so delivery
# and product each get their own. Set STORAGE_DRIVER=local only for a throwaway
# dev box (files live in the container and vanish on redeploy).
STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=https://nos.jkt-1.neo.id
STORAGE_S3_REGION=jkt-1
# delivery-service → bucket hydromart-pod
DELIVERY_STORAGE_S3_BUCKET=hydromart-pod
DELIVERY_STORAGE_S3_ACCESS_KEY_ID=
DELIVERY_STORAGE_S3_SECRET_ACCESS_KEY=
DELIVERY_STORAGE_PUBLIC_BASE_URL=https://nos.jkt-1.neo.id/hydromart-pod
# product-service → bucket hydromart-products
PRODUCT_STORAGE_S3_BUCKET=hydromart-products
PRODUCT_STORAGE_S3_ACCESS_KEY_ID=
PRODUCT_STORAGE_S3_SECRET_ACCESS_KEY=
PRODUCT_STORAGE_PUBLIC_BASE_URL=https://nos.jkt-1.neo.id/hydromart-products
# depot-service (static QRIS per depot) reuses the PRODUCT bucket under the `qris/`
# key prefix — see docker-compose.prod.yml. No extra keys needed; give it its own
# bucket by editing those four lines in the compose file. Whichever bucket serves it
# must be PUBLIC for `qris/*`: the customer's payment screen loads the image directly.

# One business timezone for the whole platform (H-16): day/month boundaries in every
# service, and the scheduler's cron clock. Leave blank to accept Asia/Jakarta.
PRICING_TZ=Asia/Jakarta

# Refunds strictly above this amount (IDR) park in the HQ approval queue instead of
# settling immediately (feature 14a / Q-11). Blank = Rp 100.000.
REFUND_HQ_THRESHOLD=100000

# ---- Monitoring (docker-compose.prod.yml) ----
# REQUIRED once the prod overlay is used: the compose file interpolates this with
# `:?`, so an unset value fails `docker compose up` for the WHOLE stack — that is
# deliberate (H-27). It used to default to `admin`. Generate one with
# `bash scripts/generate-secrets.sh`.
GRAFANA_ADMIN_PASSWORD=
