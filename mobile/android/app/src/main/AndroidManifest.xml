<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      `allowBackup` is false, against the scaffold default. Auto Backup copies app data to
      the user's Drive, and the Keystore key that decrypts the stored session is not part
      of it — so the ciphertext is useless to anyone who restores it, and the session is
      not what this protects. `hm.unlock-failures` is: a brute-force counter that can be
      rolled back by restoring a backup is not a counter. Nothing here is worth keeping
      across a factory reset either, since every screen is a view of the server.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              F3b, App Links. `autoVerify` makes Android fetch
              https://${webHost}/.well-known/assetlinks.json at install time and, if this
              app's signing certificate is listed there, open these links directly instead
              of offering a browser.

              K5.6: that file is `apps/web/public/.well-known/assetlinks.json`, served by
              the Next app out of `public/` like any other static asset. This comment used
              to send the reader to the Caddyfile, which says nothing about it — Caddy
              reverse-proxies the whole site to `web:3000` and has no `/.well-known` rule
              at all, so anyone who went looking there found nothing and had no way to tell
              whether that meant "not served" or "wrong file".

              The fingerprints in it are PLAY APP SIGNING certificates — all three per app,
              because Play holds a classical and a post-quantum one side by side and may
              present either. Never the upload key: Play re-signs every AAB, so the upload
              key's fingerprint verifies nothing and listing it hands the domain claim to
              whoever holds `upload.jks`. `scripts/check-assetlinks.mjs` names every
              fingerprint and refuses one nobody has identified.

              Both binaries are installed together on staff phones, so they must not both
              claim the same paths or Android asks the user which app to open every time.
              `linkPrefix` is what keeps them apart: the customer build claims the whole
              site, the ops build claims only `/driver`. Notification taps do not go
              through here at all — those arrive as plugin events and never leave the app
              — so the ops build losing most of this costs it nothing.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix}" />
                <!--
                  Nineteen more claimed prefixes, because one was not enough for either build.
                  Ops claimed `/driver` alone, so every manager approval link — the whole
                  `/m/manager/*` console shipped inside that same binary — opened in a
                  browser and never in the app. And the customer build claimed `/`, which
                  means it claimed `/driver` and `/m` too: on a staff phone with both apps,
                  Android had two verified claimants for one link and asked every time.
                  Naming the surfaces each binary actually SERVES is what removes that.
                  Unused slots default to the first prefix, and a duplicate `<data>` is
                  something Android collapses — so a build that needs one claim writes one.

                  J3 raised the count from twelve to twenty. Twelve was never an Android
                  limit — Android does not cap `<data>` elements — it was the number of
                  placeholders this file happened to declare, and the customer build had
                  used all of them. `/notifications`, `/addresses`, `/favorites`, `/login`,
                  `/register` and the two pages Play requires (`/kebijakan-privasi`,
                  `/hapus-akun`) were opening in a browser for want of a slot, so nothing
                  had to be given up to claim them; the list just had to get longer.
                -->
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix2}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix3}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix4}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix5}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix6}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix7}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix8}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix9}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix10}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix11}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix12}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix13}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix14}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix15}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix16}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix17}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix18}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix19}" />
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:pathPrefix="${linkPrefix20}" />
                <!--
                  J3, and the one claim that cannot be a prefix. The home page is a single
                  document, and `pathPrefix="/"` claims the entire site with it — including
                  `/driver` and `/m`, which is exactly the collision the enumeration above
                  exists to avoid. `android:path` is an EXACT match, so this claims the root
                  document and nothing under it.

                  A placeholder rather than a literal `/` because both binaries share this
                  file: the ops build points it at a path it already claims by prefix, which
                  Android collapses, so only the customer build ends up owning the home page.
                -->
                <data
                    android:scheme="https"
                    android:host="${webHost}"
                    android:path="${linkExact}" />
            </intent-filter>

        </activity>

        <!--
          F4. Without this, FCM renders the launcher icon as the status-bar notification
          and Android reduces it to its alpha channel — a solid white square on every
          push. The colour is applied by the system, so the drawable is a silhouette.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/hydromart_brand" />

        <!--
          Without this, Android files every push into its own "Miscellaneous" channel at
          default importance: no heads-up, no sound, and a user who wants to mute one kind
          of message can only mute all of them. The channel itself is created from JS the
          first time push is subscribed (`lib/push.ts`) — the id must match this string
          exactly, or Android silently falls back to Miscellaneous again and nothing looks
          wrong until someone notices notifications stopped arriving on top.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hydromart_orders" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      Permissions. Every one of these is justified line by line in
      docs/MOBILE_PLAY_STORE.md, which is the document the Play Data Safety form is
      filled in from, and `scripts/audit-manifest.mjs` fails the build on any permission
      that is not on its list — including one a plugin drags in without being asked.

      What is deliberately NOT here matters as much: no ACCESS_BACKGROUND_LOCATION (it
      needs a foreground service, a written declaration and a demo video, and this app
      only ever reads a position while the courier is looking at it), and no
      READ_MEDIA_IMAGES (the camera is captured live through getUserMedia; nothing reads
      the photo library, and asking would trigger the Photo & Video declaration process).
    -->

    <!--
      Android 11 package visibility. `<input type="file" capture>` for a proof-of-delivery
      photo reaches Capacitor's `showImageCapturePicker`, which asks
      `resolveActivity(ACTION_IMAGE_CAPTURE)` first — and without this block that call
      answers null even on a phone with a camera app, because the app is simply not
      visible to us. Capacitor then falls back to the document picker, so the courier is
      asked for camera permission and handed a gallery. Nothing in the app can tell.

      Declaring a query is not a permission: it never prompts, and it does not appear in
      the Play listing. Harmless if a future Android stops needing it.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push: Android 13+ makes this a runtime prompt, asked after the first order. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Proof-of-delivery photos and HR face check-in, both live getUserMedia captures. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Courier delivery position, foreground only (`lib/geo.ts`). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- F3b: unlocking the stored session. androidx.biometric declares it too; stated
         here so the audit reads it from our own manifest rather than from a transitive. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      O4. @capacitor/local-notifications contributes SCHEDULE_EXACT_ALARM through its AAR,
      and Play treats that one as restricted: it asks for a declaration form and an
      "alarms are the core function" justification. Ours are not scheduled at all — the
      only thing this app posts is a notification for a push that has ALREADY arrived,
      immediately, on the same channel FCM uses. An exact alarm is a capability we do not
      use and could not justify, so it is removed from the merged manifest rather than
      declared.

      If a future feature genuinely needs to schedule something at an exact wall-clock
      time, this line is the thing to delete — and the Play declaration is then owed.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
</manifest>
